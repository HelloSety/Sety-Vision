{%- assign product = product -%}
{%- assign personalizable_tag = false -%}
{%- for tag in product.tags -%}
  {%- if tag == 'personalizavel' -%}{%- assign personalizable_tag = true -%}{%- endif -%}
{%- endfor -%}

<section class="product-page container">
  <div class="breadcrumb">
    <a href="{{ routes.root_url }}">Início</a> /
    <a href="{{ routes.all_products_collection_url }}">Produtos</a> /
    <span>{{ product.title }}</span>
  </div>

  {%- form 'product', product, class: 'product-layout', id: 'product-form' -%}
    <div class="product-media">
      <div class="product-img">
        {%- if product.selected_or_first_available_variant.image -%}
          <img id="main-product-img" src="{{ product.selected_or_first_available_variant.image | image_url: width: 1200 }}" alt="{{ product.title }}" width="1200" height="{{ 1200 | divided_by: product.selected_or_first_available_variant.image.aspect_ratio }}" loading="eager">
        {%- elsif product.featured_image -%}
          <img id="main-product-img" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title }}" width="1200" height="{{ 1200 | divided_by: product.featured_image.aspect_ratio }}" loading="eager">
        {%- else -%}
          <img id="main-product-img" src="{{ 'default-hero.jpg' | asset_url }}" alt="{{ product.title }}" width="1600" height="1067">
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="gallery-thumbs" id="gallery-thumbs">
          {%- for image in product.images -%}
            <button type="button" class="{% if forloop.first %}active{% endif %}" data-full="{{ image | image_url: width: 1200 }}" aria-label="Ver imagem {{ forloop.index }} de {{ product.title }}">
              <img src="{{ image | image_url: width: 160 }}" alt="{{ product.title }} - imagem {{ forloop.index }}" width="160" height="160" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      <h1>{{ product.title }}</h1>
      <div class="product-price-row">
        {%- if product.compare_at_price > product.price -%}
          <span class="price-old">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="price-now">{{ product.price | money }}</span>
      </div>
      <span class="price-pix">{{ product.price | times: 0.9 | money }} no Pix (10% OFF) ou até 12x de {{ product.price | divided_by: 12.0 | money }} sem juros</span>

      {%- assign size_option_index = -1 -%}
      {%- for option in product.options_with_values -%}
        {%- if option.name == 'Tamanho' or option.name == 'Size' -%}
          {%- assign size_option_index = forloop.index0 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if size_option_index > -1 -%}
        <span class="size-label">Tamanho</span>
        <div class="size-grid" id="size-grid">
          {%- assign opt_key = size_option_index | plus: 1 | prepend: 'option' -%}
          {%- for value in product.options_with_values[size_option_index].values -%}
            {%- assign variant_for_value = product.variants | where: opt_key, value | first -%}
            <div class="size-opt {% if variant_for_value.available == false %}disabled{% endif %} {% if forloop.first %}active{% endif %}"
                 data-value="{{ value | escape }}"
                 data-variant-id="{{ variant_for_value.id }}"
                 title="{% if variant_for_value.available %}Disponível{% else %}Esgotado{% endif %}">{{ value }}</div>
          {%- endfor -%}
        </div>
        <select name="id" id="variant-id-select" style="display:none">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}</option>
          {%- endfor -%}
        </select>
      {%- else -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {%- endif -%}

      {%- if product.type == 'Camisas Futebol' or product.type == 'NBA' or product.type == 'Infantil' or personalizable_tag -%}
        <div class="personalize-box">
          <label>Personalização (opcional)</label>
          <div class="personalize-row">
            <input type="text" name="properties[Nome]" placeholder="Nome" maxlength="15">
            <input type="text" name="properties[Número]" placeholder="Número" maxlength="3" style="max-width:90px">
          </div>
        </div>
      {%- endif -%}

      <div class="product-desc">{{ product.description }}</div>

      {%- if product.available -%}
        <div class="add-cart-row">
          <div class="qty-selector">
            <button type="button" id="qty-dec">−</button>
            <input type="number" name="quantity" id="qty-input" value="1" min="1" style="width:36px;text-align:center;border:none;font-weight:800">
            <button type="button" id="qty-inc">+</button>
          </div>
          <button type="submit" class="btn-primary" id="add-cart-btn" style="flex:1">Comprar</button>
        </div>
      {%- else -%}
        <span class="btn-primary" style="display:inline-block;background:#6b6b6b;cursor:not-allowed">Esgotado</span>
      {%- endif -%}

      <a href="https://wa.me/{{ settings.whatsapp_number }}?text={{ 'Olá! Tenho interesse neste produto: ' | append: product.title | url_param_escape }}" target="_blank" rel="noopener" style="display:block;text-align:center;margin:8px 0 20px;color:var(--verde);font-weight:700;font-size:13.5px;text-decoration:underline">Prefere comprar direto pelo WhatsApp?</a>

      <ul class="trust-list">
        <li>Produto original Fist Street</li>
        <li>Envio para todo o Brasil</li>
        <li>Troca grátis em até 7 dias</li>
        <li>Pagamento seguro via Pix ou cartão</li>
      </ul>
    </div>
  {%- endform -%}

  <div class="related">
    <div class="section-head"><h2>Você também pode <span>gostar</span></h2></div>
    <div class="grid">
      {%- assign related_count = 0 -%}
      {%- case product.type -%}
        {%- when 'Bermuda' -%}{%- assign related_collection_handle = 'shorts' -%}
        {%- when 'Conjunto' -%}{%- assign related_collection_handle = 'outros' -%}
        {%- else -%}{%- assign related_collection_handle = product.type | handleize -%}
      {%- endcase -%}
      {%- assign related_products = collections[related_collection_handle].products -%}
      {%- if related_products.size <= 1 -%}
        {%- assign related_products = collections['all'].products -%}
      {%- endif -%}
      {%- for p in related_products -%}
        {%- if p.id != product.id and related_count < 5 -%}
          {% render 'product-card', product: p %}
          {%- assign related_count = related_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="section container" style="padding-top:0">
  {%- if section.settings.heading != blank -%}
    <div class="section-head-center"><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="collections-row">
    {%- for block in section.blocks -%}
      {%- assign col = collections[block.settings.collection] -%}
      <a class="collection-item" href="{{ col.url | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="collection-circle">
          {%- if block.settings.image -%}
            {{ block.settings.image | image_tag: width: 400, alt: block.settings.label | default: col.title, loading: 'lazy' }}
          {%- else -%}
            {%- case block.settings.collection -%}
              {%- when 'sneakers' -%}
                <img src="{{ 'cat-sneakers.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
              {%- when 'camisetas' -%}
                <img src="{{ 'cat-camisetas.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
              {%- when 'moletons-jaquetas' -%}
                <img src="{{ 'cat-moletons-jaquetas.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
              {%- when 'shorts' -%}
                <img src="{{ 'cat-shorts.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
              {%- when 'calcas' -%}
                <img src="{{ 'cat-calcas.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
              {%- else -%}
                <img src="{{ 'cat-outros.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- endcase -%}
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Categorias (círculo)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)" }
  ],
  "blocks": [
    {
      "type": "collection_circle",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "text", "id": "label", "label": "Nome exibido (opcional, usa o nome da coleção se vazio)" },
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional, usa a arte padrão da categoria se vazio)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias (círculo)",
      "blocks": [
        { "type": "collection_circle", "settings": { "collection": "sneakers", "label": "Sneakers" } },
        { "type": "collection_circle", "settings": { "collection": "camisetas", "label": "Camisetas" } },
        { "type": "collection_circle", "settings": { "collection": "moletons-jaquetas", "label": "Moletons & Jaquetas" } },
        { "type": "collection_circle", "settings": { "collection": "shorts", "label": "Shorts" } },
        { "type": "collection_circle", "settings": { "collection": "calcas", "label": "Calças" } },
        { "type": "collection_circle", "settings": { "collection": "outros", "label": "Outros" } }
      ]
    }
  ]
}
{% endschema %}

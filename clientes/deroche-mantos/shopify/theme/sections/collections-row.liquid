<section class="section container" style="padding-top:0">
  <div class="section-head-center"><h2>{{ section.settings.heading | default: 'Encontre sua Categoria' }}</h2></div>
  <p class="section-sub">Coleções</p>
  <div class="collections-row">
    {%- for block in section.blocks -%}
      {%- assign col = collections[block.settings.collection] -%}
      {%- if col != blank -%}
        <a class="collection-item" href="{{ col.url }}">
          <div class="collection-circle">
            {%- if col.image -%}
              {{ col.image | image_tag: width: 400, alt: col.title, loading: 'lazy' }}
            {%- elsif col.products.first.featured_image -%}
              {{ col.products.first.featured_image | image_tag: width: 400, alt: col.title, loading: 'lazy' }}
            {%- else -%}
              <img src="{{ 'default-hero.jpg' | asset_url }}" alt="{{ col.title }}" width="1600" height="1067" loading="lazy">
            {%- endif -%}
            <span>{{ block.settings.label | default: col.title }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrossel de Coleções",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Encontre sua Categoria" }
  ],
  "blocks": [
    {
      "type": "collection_circle",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "text", "id": "label", "label": "Nome exibido (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrossel de Coleções",
      "blocks": [
        { "type": "collection_circle" }, { "type": "collection_circle" }, { "type": "collection_circle" },
        { "type": "collection_circle" }, { "type": "collection_circle" }, { "type": "collection_circle" }
      ]
    }
  ]
}
{% endschema %}

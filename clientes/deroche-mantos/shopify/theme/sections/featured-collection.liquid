{%- assign col = collections[section.settings.collection] -%}
<section class="section container" {% if section.settings.no_top_padding %}style="padding-top:0"{% endif %}>
  <div class="section-head-center"><h2>{{ section.settings.heading | default: col.title }}</h2></div>
  {%- if section.settings.subheading != blank -%}
    <p class="section-sub">{{ section.settings.subheading }}</p>
  {%- endif -%}
  <div class="grid">
    {%- for product in col.products limit: section.settings.products_to_show -%}
      {% render 'product-card', product: product %}
    {%- endfor -%}
  </div>
  {%- if col.url -%}
    <div class="center-cta"><a class="btn-dark" href="{{ col.url }}">{{ section.settings.cta_label | default: 'Ver Todos' }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Grid de Coleção",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "text", "id": "heading", "label": "Título (opcional, usa o nome da coleção se vazio)" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "text", "id": "cta_label", "label": "Texto do botão", "default": "Ver Todos" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 10, "step": 1, "default": 5, "label": "Quantos produtos mostrar" },
    { "type": "checkbox", "id": "no_top_padding", "label": "Remover espaço acima", "default": true }
  ],
  "presets": [{ "name": "Grid de Coleção" }]
}
{% endschema %}

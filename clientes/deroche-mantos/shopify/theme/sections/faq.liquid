<section class="section container" style="padding-top:0" id="faq-list">
  <div class="section-head-center"><h2>{{ section.settings.heading | default: 'Dúvidas Frequentes' }}</h2></div>
  <p class="section-sub">{{ section.settings.subheading | default: 'Atendemos de segunda a sábado, das 9h às 18h, em todos os nossos canais' }}</p>
  <div class="faq-list">
    {%- for block in section.blocks -%}
      <div class="faq-item">
        <button class="faq-q" type="button">{{ block.settings.question }}<span class="plus">+</span></button>
        <div class="faq-a"><p>{{ block.settings.answer }}</p></div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Dúvidas Frequentes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Dúvidas Frequentes" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta" },
        { "type": "textarea", "id": "answer", "label": "Resposta" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dúvidas Frequentes",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "O site é seguro?", "answer": "Sim. Todas as informações de pagamento são processadas com criptografia e segurança de ponta a ponta." } },
        { "type": "faq_item", "settings": { "question": "E se o produto não servir?", "answer": "Você tem até 7 dias após o recebimento para solicitar troca de tamanho, sem custo adicional." } },
        { "type": "faq_item", "settings": { "question": "Como acompanho meu pedido?", "answer": "Assim que o pedido é despachado, você recebe o código de rastreio por WhatsApp e e-mail." } },
        { "type": "faq_item", "settings": { "question": "Quais formas de pagamento vocês aceitam?", "answer": "Pix (com desconto), cartão de crédito em até 12x e boleto bancário." } },
        { "type": "faq_item", "settings": { "question": "Em quanto tempo meu pedido chega?", "answer": "O prazo médio é de 7 a 15 dias úteis, variando conforme sua região." } },
        { "type": "faq_item", "settings": { "question": "Vocês fazem personalização (nome e número)?", "answer": "Sim, em camisas! É só preencher o campo de personalização na página do produto." } }
      ]
    }
  ]
}
{% endschema %}

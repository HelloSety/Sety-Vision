<section class="banner-slider" aria-label="{{ 'sections.banner_slideshow.aria_label' | t }}">
  <div class="banner-track">
    {% for block in section.blocks %}
      <a class="banner-slide" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        <picture>
          {% if block.settings.image_mobile %}
            <source media="(max-width: 720px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">
          {% endif %}
          {% if block.settings.image_desktop %}
            <img
              src="{{ block.settings.image_desktop | image_url: width: 1800 }}"
              srcset="{{ block.settings.image_desktop | image_url: width: 900 }} 900w, {{ block.settings.image_desktop | image_url: width: 1800 }} 1800w"
              sizes="100vw"
              alt="{{ block.settings.image_desktop.alt | default: block.settings.title | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ block.settings.image_desktop.width }}"
              height="{{ block.settings.image_desktop.height }}"
            >
          {% else %}
            <div class="banner-slide-placeholder">{{ 'sections.banner_slideshow.placeholder' | t }}</div>
          {% endif %}
        </picture>
      </a>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <button class="banner-arrow prev" aria-label="{{ 'sections.banner_slideshow.previous' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
    <button class="banner-arrow next" aria-label="{{ 'sections.banner_slideshow.next' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
    <div class="banner-dots"></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Slideshow de banners",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagem desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem mobile (opcional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Texto alternativo (acessibilidade)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link ao clicar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow de banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}

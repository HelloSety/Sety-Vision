<section class="products-section container">
  <div class="tiles-title">
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.view_all_collection != blank %}
      <a href="{{ section.settings.view_all_collection.url }}">{{ 'products.view_all' | t }} →</a>
    {% endif %}
  </div>
  {% if section.blocks.size > 0 %}
    <div class="tabs">
      {% for block in section.blocks %}
        <button class="tab-btn{% if forloop.first %} active{% endif %}" data-tab="tab-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.collection.title | default: block.settings.label | upcase }}</button>
      {% endfor %}
    </div>
    {% for block in section.blocks %}
      <div class="tab-panel{% if forloop.first %} active{% endif %}" id="tab-{{ block.id }}">
        <div class="product-row">
          <button class="carousel-arrow prev">‹</button>
          <div class="product-grid">
            {% assign col = block.settings.collection %}
            {% for product in col.products limit: 12 %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>
          <button class="carousel-arrow next">›</button>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Destaques em abas",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Destaques" },
    { "type": "collection", "id": "view_all_collection", "label": "Coleção do link \"ver todos\"" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Aba",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "text", "id": "label", "label": "Rótulo (se a coleção não tiver título)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Destaques em abas",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}

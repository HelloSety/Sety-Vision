<section class="faq container">
  <div class="faq-title">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="faq-list">
    {% for block in section.blocks %}
      <details class="faq-item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <p>{{ block.settings.answer }}</p>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Perguntas frequentes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Perguntas frequentes" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Tudo que você precisa saber antes de comprar" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta" },
        { "type": "textarea", "id": "answer", "label": "Resposta" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [
        { "type": "question", "settings": { "question": "Os produtos são originais?", "answer": "Sim. Trabalhamos só com produto original das marcas — MTN, Colorgin, NOU Colors, Posca, Uni — sem falsificação. Time que pinta e testa cada item antes de vender." } },
        { "type": "question", "settings": { "question": "Vocês têm loja física?", "answer": "Sim, além da loja online temos ponto físico. Passa lá pra ver de perto, testar cor e trocar ideia com a equipe." } },
        { "type": "question", "settings": { "question": "Enviam pra todo o Brasil?", "answer": "Enviamos sim, pra todo o país. O prazo e o valor do frete são calculados no fechamento do pedido." } },
        { "type": "question", "settings": { "question": "Como faço pra comprar?", "answer": "Escolhe o produto, adiciona ao carrinho e finaliza a compra direto pelo site." } },
        { "type": "question", "settings": { "question": "Quais as formas de pagamento?", "answer": "Pix, cartão e outras formas disponíveis no checkout." } }
      ]
    }
  ]
}
{% endschema %}

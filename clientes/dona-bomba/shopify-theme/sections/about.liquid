<section class="about container" id="sobre">
  <div class="about-grid">
    <div class="about-media">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy" width="900" height="{{ section.settings.image.height }}">
      {% endif %}
    </div>
    <div class="about-text">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      {{ section.settings.body }}
      {% if section.settings.button_label != blank %}
        <a class="btn" href="{{ section.settings.button_link | default: '#' }}" target="_blank" rel="noopener">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sobre a loja",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "eyebrow", "label": "Selo pequeno", "default": "SOBRE A LOJA" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Loja física, feita pra quem vive a rua" },
    { "type": "richtext", "id": "body", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "FALAR COM A LOJA" },
    { "type": "url", "id": "button_link", "label": "Link do botão" }
  ],
  "presets": [{ "name": "Sobre a loja" }]
}
{% endschema %}

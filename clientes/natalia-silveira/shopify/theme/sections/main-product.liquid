      "id": "bespoke_body",
      "label": "Texto",
      "default": "Cada peça é produzida exclusivamente sob medida. Prazo: até 20 dias corridos além do envio."
    },
    {
      "type": "header",
      "content": "Labels do Accordion"
    },
    {
      "type": "text",
      "id": "acc_details_label",
      "label": "Label: Detalhes",
      "default": "DETALHES DA PEÇA"
    },
    {
      "type": "text",
      "id": "acc_size_label",
      "label": "Label: Tabela de Medidas",
      "default": "TABELA DE MEDIDAS"
    },
    {
      "type": "text",
      "id": "acc_colors_label",
      "label": "Label: Tabela de Cores",
      "default": "TABELA DE CORES"
    },
    {
      "type": "text",
      "id": "acc_shipping_label",
      "label": "Label: Envio",
      "default": "ENVIO E PRAZO"
    },
    {
      "type": "text",
      "id": "acc_care_label",

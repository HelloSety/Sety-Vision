<div class="page-wrap" style="max-width:900px;margin:80px auto;padding:0 24px;">
  <h1 style="font-family:'Cormorant Garamond',serif;font-weight:300;font-size:28px;letter-spacing:4px;margin-bottom:16px;text-align:center;">
    {{ section.settings.page_title | default: 'TABELA DE CORES' }}
  </h1>
  <p style="font-family:Jost,sans-serif;font-size:13px;color:#767676;text-align:center;max-width:520px;margin:0 auto 40px;">
    {{ section.settings.page_subtitle | default: 'Escolha a cor do fio da sua peça. A cor final pode variar levemente conforme o monitor — em caso de dúvida, confirme pelo WhatsApp antes de encomendar.' }}
  </p>
  <hr style="border:none;border-top:1px solid #E5E5E5;margin-bottom:8px;">

  <div class="color-ref-grid">
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#F2EEE8;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)"></span><span>Branco</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#E2D4B8"></span><span>Creme</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#C8B890"></span><span>Porcelana</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#7A4830"></span><span>Castanha</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#B84E20"></span><span>Valência</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#A83A1A"></span><span>Terracota</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#A05018"></span><span>Cobre</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#4A2010"></span><span>Chocolate</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#B82808"></span><span>Brasa</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#B80C18"></span><span>Vermelho Círculo</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#7A0C18"></span><span>Valentino</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#0A2CC8"></span><span>Azul Bic</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#404C24"></span><span>Militar</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#283018"></span><span>Musgo</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#A8A090;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)"></span><span>Pergaminho</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#8A8A8A"></span><span>Alumínio</span></div>
    <div class="color-ref-item"><span class="color-ref-swatch" style="background:#1A1210"></span><span>Preto</span></div>
  </div>
  <p class="color-ref-note" style="text-align:center;">{{ section.settings.footer_note | default: 'Fio Náutico Premium — linha oficial de cores Natalia Silveira.' }}</p>
</div>

<style>
  .page-wrap .rte { font-family: Jost, sans-serif; font-size: 14px; line-height: 1.8; color: #444; }
  .color-ref-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; padding: 32px 0; }
  .color-ref-item { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .color-ref-swatch { width: 48px; height: 48px; border-radius: 50%; }
  .color-ref-item span:last-child { font-family: Jost, sans-serif; font-size: 11px; letter-spacing: 0.3px; color: #444; line-height: 1.3; }
  .color-ref-note { font-family: Jost, sans-serif; font-size: 11px; color: #767676; line-height: 1.6; padding-top: 8px; }
  @media (max-width: 600px) {
    .color-ref-grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
  }
</style>

{% schema %}
{
  "name": "Tabela de Cores",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Título da página",
      "default": "TABELA DE CORES"
    },
    {
      "type": "textarea",
      "id": "page_subtitle",
      "label": "Subtítulo",
      "default": "Escolha a cor do fio da sua peça. A cor final pode variar levemente conforme o monitor — em caso de dúvida, confirme pelo WhatsApp antes de encomendar."
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Nota final",
      "default": "Fio Náutico Premium — linha oficial de cores Natalia Silveira."
    }
  ],
  "presets": [
    { "name": "Tabela de Cores" }
  ]
}
{% endschema %}
</content>

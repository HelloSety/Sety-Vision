{{ 'monster-lupas.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient ml-sticker-section" id="produtos">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="ml-carousel-head">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ml-category-tabs">
        {%- if section.settings.collection != blank -%}
          <a href="{{ section.settings.collection.url }}" class="ml-category-tab">Todos</a>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.collection.url }}" class="ml-category-tab" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="ml-sticker-row-wrap" data-ml-carousel>
      <button type="button" class="ml-carousel-arrow ml-carousel-arrow--prev" data-ml-prev aria-label="Anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="ml-sticker-row" id="ml-sticker-row-{{ section.id }}" data-ml-track>
        {%- if section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            <a href="{{ product.url }}" class="ml-sticker-item is-visible">
              <div class="ml-sticker-tile">
                {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title }}
              </div>
              <span>{{ product.title }}</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button type="button" class="ml-carousel-arrow ml-carousel-arrow--next" data-ml-next aria-label="Próximo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Compre por modelo",
  "tag": "section",
  "class": "section-ml-sticker",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Compre por Modelo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção (catálogo completo)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produtos a mostrar",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category_tab",
      "name": "Aba de categoria",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nome exibido",
          "default": "Linha Esportiva"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Coleção correspondente"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compre por modelo",
      "blocks": [
        { "type": "category_tab", "settings": { "label": "Linha X-Metal" } },
        { "type": "category_tab", "settings": { "label": "Linha Esportiva" } },
        { "type": "category_tab", "settings": { "label": "Linha Clássica" } },
        { "type": "category_tab", "settings": { "label": "Linha Streetwear" } }
      ]
    }
  ]
}
{% endschema %}

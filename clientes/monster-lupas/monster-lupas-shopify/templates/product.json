{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "badges-top": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ml-pd-badges\"><span class=\"ml-pd-badge ml-pd-badge--promo\">Compre 1, Leve 2</span><span class=\"ml-pd-badge ml-pd-badge--quality\">Qualidade Premium</span></div>"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "pix-install": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign ml_variant = product.selected_or_first_available_variant %}<p class=\"ml-pd-pix\">No Pix: <strong>{{ ml_variant.price | times: 0.95 | money }}</strong> (5% off)</p><p class=\"ml-pd-install\">ou 6x de {{ ml_variant.price | divided_by: 6.0 | money }} sem juros</p>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "payment-trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ml-pd-payment-row\"><span>VISA</span><span>MASTER</span><span>PIX</span><span>ELO</span><span>AMEX</span><span>BOLETO</span></div><ul class=\"ml-pd-trust\"><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 2 4 6v6c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6l-8-4Z\"/><path d=\"m9 12 2 2 4-4\"/></svg> Proteção UV400 e lente polarizada</li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg> Envio em até 24h úteis</li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg> 7 dias de garantia</li></ul>"
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartilhar"
          }
        }
      },
      "block_order": [
        "badges-top",
        "title",
        "price",
        "pix-install",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "payment-trust",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Outros Modelos",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'autenticas-store.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient as-carousel-section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="as-carousel-head">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="as-carousel-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- assign as_col = collections[section.settings.collection] -%}
    <div class="as-carousel-wrap" data-as-carousel>
      <button type="button" class="as-carousel-arrow as-carousel-arrow--prev" data-as-prev aria-label="Anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="as-carousel-track" data-as-track>
        {%- if as_col != blank -%}
          {%- for product in as_col.products limit: section.settings.products_to_show -%}
            {%- render 'as-card-product', card_product: product -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button type="button" class="as-carousel-arrow as-carousel-arrow--next" data-as-next aria-label="Próximo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    {%- if section.settings.show_view_all and as_col != blank -%}
      <div class="center-cta" style="text-align:center; margin-top:28px;">
        <a href="{{ as_col.url }}" class="button button--secondary">Ver coleção completa</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Carrossel de produtos",
  "tag": "section",
  "class": "section-as-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Novidades"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produtos a mostrar",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botão \"Ver coleção completa\"",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Carrossel de produtos"
    }
  ]
}
{% endschema %}

{{ 'autenticas-store.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient as-sticker-section" id="produtos">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="as-carousel-head">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- assign as_all_col = collections[section.settings.collection] -%}
    {%- if section.blocks.size > 0 -%}
      <div class="as-category-tabs">
        {%- if as_all_col != blank -%}
          <a href="{{ as_all_col.url }}" class="as-category-tab">Todos</a>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign as_tab_col = collections[block.settings.collection] -%}
          <a href="{{ as_tab_col.url }}" class="as-category-tab" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="as-sticker-row-wrap" data-as-carousel>
      <button type="button" class="as-carousel-arrow as-carousel-arrow--prev" data-as-prev aria-label="Anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="as-sticker-row" id="as-sticker-row-{{ section.id }}" data-as-track>
        {%- for block in section.blocks -%}
          {%- assign as_tab_col = collections[block.settings.collection] -%}
          {%- assign as_tab_cover = block.settings.image | default: as_tab_col.products.first.featured_image -%}
          <a href="{{ as_tab_col.url }}" class="as-sticker-item is-visible" {{ block.shopify_attributes }}>
            <div class="as-sticker-tile">
              {%- if as_tab_cover != blank -%}
                {{ as_tab_cover | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.label }}
              {%- endif -%}
            </div>
            <span>{{ block.settings.label }}</span>
          </a>
        {%- endfor -%}
      </div>
      <button type="button" class="as-carousel-arrow as-carousel-arrow--next" data-as-next aria-label="Próximo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Compre por categoria",
  "tag": "section",
  "class": "section-as-sticker",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Compre por Categoria"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção (catálogo completo)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produtos a mostrar",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category_tab",
      "name": "Aba de categoria",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nome exibido",
          "default": "Linha Esportiva"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Coleção correspondente"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem da categoria (opcional, senão usa a 1ª imagem da coleção)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compre por categoria",
      "blocks": [
        { "type": "category_tab", "settings": { "label": "Roupas" } },
        { "type": "category_tab", "settings": { "label": "Tênis" } },
        { "type": "category_tab", "settings": { "label": "Chinelos" } },
        { "type": "category_tab", "settings": { "label": "Bonés & Acessórios" } }
      ]
    }
  ]
}
{% endschema %}

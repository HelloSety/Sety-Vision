<div class="banner-hero" style="line-height:0;">
  <a href="{{ section.settings.link | default: '#produtos' }}" aria-label="Ver coleção Autênticas Store">
    <picture>
      {%- if section.settings.image_mobile != blank -%}
        <source media="(max-width: 720px)" srcset="{{ section.settings.image_mobile | asset_url }}">
      {%- endif -%}
      <img
        src="{{ section.settings.image_desktop | asset_url }}"
        alt="{{ section.settings.alt | default: shop.name }}"
        width="1600"
        height="{{ section.settings.height | default: 600 }}"
        style="width:100%; height:auto; display:block;"
        {% if section.settings.priority %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
      >
    </picture>
  </a>
</div>

{% schema %}
{
  "name": "Banner (asset do tema)",
  "tag": "section",
  "class": "section-as-banner",
  "settings": [
    {
      "type": "text",
      "id": "image_desktop",
      "label": "Nome do arquivo (desktop) em Assets",
      "info": "Ex: banner-hero-desktop.jpg — precisa já estar em Assets do tema",
      "default": "banner-hero-desktop.jpg"
    },
    {
      "type": "text",
      "id": "image_mobile",
      "label": "Nome do arquivo (mobile) em Assets",
      "default": "banner-hero-mobile.jpg"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Texto alternativo",
      "default": "Autênticas Store — Nova Coleção"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link ao clicar"
    },
    {
      "type": "checkbox",
      "id": "priority",
      "label": "Prioridade de carregamento (usar só no 1º banner da página)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Banner (asset do tema)"
    }
  ]
}
{% endschema %}

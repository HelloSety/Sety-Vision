{{ 'autenticas-store.css' | asset_url | stylesheet_tag }}

<footer class="color-{{ section.settings.color_scheme }} gradient as-site-footer">
  <div class="page-width">
    <div class="as-footer-grid">
      <div>
        <img class="as-footer-logo" src="{{ section.settings.logo_file | asset_url }}" alt="{{ shop.name }}" loading="lazy" width="44" height="44">
        <p>{{ section.settings.about_text }}</p>
        {%- if section.settings.instagram_url != blank -%}
          <div class="as-footer-social">
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
          </div>
        {%- endif -%}
      </div>

      <div>
        <h4>Menu</h4>
        <ul>
          <li><a href="{{ routes.root_url }}">Início</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Produtos</a></li>
          <li><a href="{{ collections['mais-vendidos'].url | default: '/collections/mais-vendidos' }}">Promoções</a></li>
          <li><a href="#sobre">Sobre</a></li>
        </ul>
      </div>

      <div>
        <h4>Institucional</h4>
        <ul>
          <li><a href="{{ section.settings.faq_url | default: '/#faq' }}">Perguntas Frequentes</a></li>
          <li><a href="{{ pages['politica-de-trocas'].url | default: '/#faq' }}">Política de Trocas</a></li>
          <li><a href="{{ pages['politica-de-privacidade'].url | default: '/#faq' }}">Política de Privacidade</a></li>
          <li><a href="{{ pages['termos-de-uso'].url | default: '/#faq' }}">Termos de Uso</a></li>
        </ul>
      </div>

      <div>
        <h4>Central de Atendimento</h4>
        <ul>
          <li>{{ section.settings.address }}</li>
          <li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>
        </ul>
        <a class="as-footer-whats" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 32 32" width="16" height="16"><circle cx="16" cy="16" r="16" fill="#25D366"/><path fill="#fff" d="M23.5 8.5a10 10 0 0 0-15.9 12L6 26l5.7-1.5a10 10 0 0 0 4.3 1 10 10 0 0 0 7.5-16.9zm-7.5 15.4a8.3 8.3 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3a8.3 8.3 0 1 1 15.4-4.4 8.3 8.3 0 0 1-8.4 8.2z"/></svg>
          Atendimento via WhatsApp
        </a>
      </div>

      <div>
        <h4>Formas de Pagamento</h4>
        <div class="as-payment-icons">
          <span>VISA</span><span>MASTER</span><span>PIX</span><span>ELO</span><span>AMEX</span><span>BOLETO</span>
        </div>
        <h4 style="margin-top:26px">Segurança</h4>
        <div class="as-trust-badges">
          <span><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> Site Seguro SSL</span>
          <span><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v6c0 5-3.4 8.6-8 11-4.6-2.4-8-6-8-11V5l8-3z"/><path d="M9 12l2 2 4-4"/></svg> Compra Garantida</span>
          <span><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v6c0 5-3.4 8.6-8 11-4.6-2.4-8-6-8-11V5l8-3z"/><path d="M9 12l2 2 4-4"/></svg> Garantia 7 Dias</span>
        </div>
      </div>
    </div>
    <div class="as-footer-bottom">
      © {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos os direitos reservados.
      <a class="as-footer-credit" href="https://setystudio.com.br" target="_blank" rel="noopener">Feito por Sety Studio</a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé Autênticas Store",
  "tag": "footer",
  "class": "section-as-footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_file",
      "label": "Nome do arquivo de logo em Assets",
      "default": "autenticas-store-logo.png"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Texto sobre a loja",
      "default": "Moda masculina de altíssima qualidade e preço justo. Roupas, tênis, chinelos e bonés selecionados a dedo."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Link do Instagram"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Endereço",
      "default": "Rua Yutaka Hashinukuti, 428 — Nova Andradina/MS"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mail de contato",
      "default": "contato@autenticasstore.com.br"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "Link do WhatsApp"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "Link Perguntas Frequentes"
    },
    {
      "type": "url",
      "id": "policy_url",
      "label": "Link Política de Trocas"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Link Política de Privacidade"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Link Termos de Uso"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}

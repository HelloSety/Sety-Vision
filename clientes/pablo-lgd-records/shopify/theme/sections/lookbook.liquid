<div class="lookbook-hero">
  <p class="lookbook-hero-eyebrow">{{ section.settings.eyebrow | default: 'LGD RECORDS / SS 2025' }}</p>
  <h1 class="lookbook-hero-title">{{ section.settings.title | default: 'LOOK<br>BOOK' }}</h1>
  <p class="lookbook-hero-sub">{{ section.settings.subtitle | default: 'Drop 01. A nova estética do underground.<br>Streetwear que carrega cultura, música e identidade.<br>Cada peça, uma declaração.' }}</p>
</div>

<div class="lookbook-stats">
  <div class="lookbook-stat">
    <p class="lookbook-stat-num">{{ section.blocks.size }}</p>
    <p class="lookbook-stat-label">PEÇAS NA COLEÇÃO</p>
  </div>
  <div class="lookbook-stat">
    <p class="lookbook-stat-num">{{ section.settings.season | default: 'SS25' }}</p>
    <p class="lookbook-stat-label">TEMPORADA</p>
  </div>
  <div class="lookbook-stat">
    <p class="lookbook-stat-num">{{ section.settings.drop | default: '01' }}</p>
    <p class="lookbook-stat-label">DROP</p>
  </div>
</div>

<div class="lookbook-masonry">
  {%- for block in section.blocks -%}
    <div class="lb-masonry-item" {{ block.shopify_attributes }}>
      <div class="lb-masonry-frame">
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" loading="lazy" width="800" height="1000">
        {%- else -%}
          <img src="https://picsum.photos/seed/lgd-lookbook-{{ forloop.index }}/800/1000" alt="{{ block.settings.title }}" loading="lazy" width="800" height="1000">
        {%- endif -%}
        <span class="lb-wm">{{ block.settings.watermark | default: 'LGD' }}</span>
        <div class="lb-overlay"></div>
        <div class="lb-meta">
          <p class="lb-meta-num">LGD {{ section.settings.season | default: 'SS25' }} — {{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          <p class="lb-meta-title">{{ block.settings.title | default: 'PEÇA' }}</p>
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

<section class="lookbook-cta">
  <p class="lookbook-cta-eyebrow">{{ section.settings.season | default: 'SS 2025' }} / {{ section.settings.cta_eyebrow | default: 'DROP 01' }}</p>
  <h2 class="lookbook-cta-title">{{ section.settings.cta_title | default: 'COMPRE<br>A COLEÇÃO' }}</h2>
  <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn-white">{{ section.settings.cta_text | default: 'ACESSAR SHOP' }}</a>
</section>

<style>
  .lookbook-hero { padding: 80px 48px 64px; border-bottom: 1px solid var(--gray-700); }
  .lookbook-hero-eyebrow { font-size: 10px; letter-spacing: 0.45em; color: var(--gray-400); text-transform: uppercase; margin-bottom: 14px; }
  .lookbook-hero-title { font-size: clamp(52px, 8vw, 96px); font-weight: 300; letter-spacing: 0.02em; line-height: 0.9; margin-bottom: 18px; }
  .lookbook-hero-sub { font-size: 12px; color: var(--gray-400); max-width: 440px; line-height: 1.9; }
  .lookbook-stats { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--gray-700); }
  .lookbook-stat { padding: 24px 48px; border-right: 1px solid var(--gray-700); }
  .lookbook-stat:last-child { border-right: none; }
  .lookbook-stat-num { font-size: 2.5rem; letter-spacing: 0.04em; }
  .lookbook-stat-label { font-size: 0.65rem; letter-spacing: 0.3em; color: var(--gray-400); margin-top: 4px; }
  .lookbook-masonry { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 4px; }
  .lb-masonry-item { position: relative; overflow: hidden; aspect-ratio: 3/4; cursor: pointer; background: #111; }
  .lb-masonry-frame { position: relative; width: 100%; height: 100%; }
  .lb-masonry-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(30%) contrast(1.12) brightness(0.65); transition: transform 0.65s ease, filter 0.4s ease; z-index: 0; }
  .lb-masonry-item:hover .lb-masonry-frame img { transform: scale(1.04); filter: grayscale(15%) contrast(1.08) brightness(0.75); }
  .lb-wm { position: absolute; font-size: 7rem; font-weight: 800; letter-spacing: 0.08em; color: rgba(255,255,255,0.06); top: 50%; left: 50%; transform: translate(-50%, -50%); white-space: nowrap; pointer-events: none; z-index: 1; }
  .lb-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0); transition: background 0.4s; z-index: 2; }
  .lb-masonry-item:hover .lb-overlay { background: rgba(0,0,0,0.35); }
  .lb-meta { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px 16px; background: linear-gradient(transparent, rgba(0,0,0,0.8)); z-index: 3; opacity: 0; transition: opacity 0.3s; }
  .lb-masonry-item:hover .lb-meta { opacity: 1; }
  .lb-meta-num { font-size: 9px; letter-spacing: 0.35em; color: var(--gray-400); margin-bottom: 3px; text-transform: uppercase; }
  .lb-meta-title { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--white); }
  .lookbook-cta { padding: 80px 48px; text-align: center; border-top: 1px solid var(--gray-700); }
  .lookbook-cta-eyebrow { font-size: 0.7rem; letter-spacing: 0.5em; color: var(--gray-400); margin-bottom: 16px; }
  .lookbook-cta-title { font-size: clamp(48px, 7vw, 96px); line-height: 0.9; margin-bottom: 32px; }
  @media (max-width: 768px) {
    .lookbook-masonry { grid-template-columns: repeat(2, 1fr); }
    .lookbook-hero { padding: 48px 20px 40px; }
    .lookbook-stat { padding: 20px 16px; }
    .lb-meta { opacity: 1; }
  }
</style>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LGD RECORDS / SS 2025" },
    { "type": "text", "id": "title", "label": "Título (aceita <br>)", "default": "LOOK<br>BOOK" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo (aceita <br>)", "default": "Drop 01. A nova estética do underground.<br>Streetwear que carrega cultura, música e identidade.<br>Cada peça, uma declaração." },
    { "type": "text", "id": "season", "label": "Temporada", "default": "SS25" },
    { "type": "text", "id": "drop", "label": "Drop", "default": "01" },
    { "type": "header", "content": "CTA final" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow do CTA", "default": "DROP 01" },
    { "type": "text", "id": "cta_title", "label": "Título do CTA (aceita <br>)", "default": "COMPRE<br>A COLEÇÃO" },
    { "type": "text", "id": "cta_text", "label": "Texto do botão", "default": "ACESSAR SHOP" },
    { "type": "url", "id": "cta_url", "label": "Link do botão" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Peça do Lookbook",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto (vazio = placeholder de exemplo)" },
        { "type": "text", "id": "title", "label": "Nome da peça", "default": "LEGACY BLACK" },
        { "type": "text", "id": "watermark", "label": "Marca d'água no fundo", "default": "LGD" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "look", "settings": { "title": "LEGACY BLACK", "watermark": "LGD" } },
        { "type": "look", "settings": { "title": "CHAOS WHITE", "watermark": "REC" } },
        { "type": "look", "settings": { "title": "JERSEY RECORDS", "watermark": "LGD" } },
        { "type": "look", "settings": { "title": "UNDERGROUND CLUB", "watermark": "" } },
        { "type": "look", "settings": { "title": "VISION BLACK", "watermark": "SS25" } },
        { "type": "look", "settings": { "title": "VINTAGE RAP", "watermark": "" } },
        { "type": "look", "settings": { "title": "NO RULES", "watermark": "LGD" } },
        { "type": "look", "settings": { "title": "STREET DIVISION", "watermark": "" } },
        { "type": "look", "settings": { "title": "CLASSIC HOOD", "watermark": "RECORDS" } },
        { "type": "look", "settings": { "title": "NIGHT VISION", "watermark": "" } },
        { "type": "look", "settings": { "title": "ARCHIVE TEE", "watermark": "DROP01" } },
        { "type": "look", "settings": { "title": "SIGNATURE", "watermark": "LGD" } }
      ]
    }
  ]
}
{% endschema %}

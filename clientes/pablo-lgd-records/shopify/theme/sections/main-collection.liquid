<div class="collection-wrap">
  <h2 class="sec-title">{{ collection.title }}</h2>
  {%- if collection.description != blank -%}
    <div class="collection-desc">{{ collection.description }}</div>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="product-grid">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <p style="grid-column:1/-1;text-align:center;padding:60px 0;color:var(--gray);font-size:12px;letter-spacing:0.08em;">
          Nenhum produto encontrado nesta coleção.
        </p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Anterior</a>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Próxima →</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<style>
  .collection-desc { text-align:center; max-width:600px; margin:0 auto 24px; font-size:12px; color:var(--gray); padding:0 24px; }
  .pagination { display:flex; align-items:center; justify-content:center; gap:24px; padding:32px 24px 72px; font-size:11px; letter-spacing:0.1em; }
  .pagination a { color:var(--white); border-bottom:1px solid var(--white); }
  .pagination span { color:var(--gray); }
</style>

{% schema %}
{
  "name": "Coleção",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "default": 24, "label": "Produtos por página" }
  ]
}
{% endschema %}

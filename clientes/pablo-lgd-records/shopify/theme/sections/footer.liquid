<footer class="footer">
  <div class="footer-grid">
    <div class="footer-col">
      <h4>Navegação</h4>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- for link in section.settings.footer_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <div class="footer-col">
      <h4>Entre em contato</h4>
      {%- if settings.wpp_number != blank -%}
        <a href="https://wa.me/{{ settings.wpp_number }}" target="_blank" rel="noopener">{{ settings.wpp_display | default: settings.wpp_number }}</a>
      {%- endif -%}
    </div>
    <div class="footer-col" style="display:flex;align-items:flex-start;justify-content:flex-end;">
      <div class="footer-social">
        {%- if settings.instagram != blank -%}
          <a href="https://www.instagram.com/{{ settings.instagram }}/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.tiktok != blank -%}
          <a href="https://www.tiktok.com/@{{ settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.87a8.23 8.23 0 0 0 4.81 1.54V7c-.92 0-1.87-.22-2.04-.31Z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-logo-bottom">{{ section.settings.logo_text | default: 'LGD' }}</span>
    <p class="footer-copy">Copyright {{ 'now' | date: '%Y' }} LGD Records — Todos os direitos reservados.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo do rodapé",
      "default": "LGD"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Menu de navegação (ex: Lookbook)",
      "default": "footer"
    }
  ]
}
{% endschema %}

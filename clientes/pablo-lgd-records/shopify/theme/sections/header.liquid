{%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
  <div class="announcement-bar">
    <div class="announcement-track">
      {%- for i in (1..6) -%}<span>{{ section.settings.announcement_text }}</span>{%- endfor -%}
    </div>
  </div>
{%- endif -%}

<header class="header">
  <a href="{{ routes.root_url }}" class="header-logo">{{ section.settings.logo_text | default: 'LGD' }}</a>
  <nav class="header-nav">
    <a href="{{ routes.all_products_collection_url }}">{{ section.settings.nav_shop | default: 'SHOP' }}</a>
    {%- if section.settings.lookbook_url != blank -%}
      <a href="{{ section.settings.lookbook_url }}">{{ section.settings.nav_lookbook | default: 'LOOKBOOK' }}</a>
    {%- endif -%}
    {%- for link in section.settings.main_menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>
  <div class="header-icons">
    <a href="{{ routes.search_url }}" aria-label="Busca">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </a>
    <a href="{{ routes.account_url }}" aria-label="Conta">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </a>
    <button id="cartBtn" class="cart-icon-wrap" aria-label="Carrinho">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="cart-badge" id="cartBadge">{{ cart.item_count }}</span>
    </button>
    <button class="hamburger" id="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</header>

<nav class="mobile-nav" id="mobileNav">
  <button class="mobile-nav-close" id="mobileNavClose">✕</button>
  <a href="{{ routes.all_products_collection_url }}">{{ section.settings.nav_shop | default: 'SHOP' }}</a>
  {%- if section.settings.lookbook_url != blank -%}
    <a href="{{ section.settings.lookbook_url }}">{{ section.settings.nav_lookbook | default: 'LOOKBOOK' }}</a>
  {%- endif -%}
  {%- for link in section.settings.main_menu.links -%}
    <a href="{{ link.url }}">{{ link.title }}</a>
  {%- endfor -%}
</nav>

<div class="cart-overlay" id="cartOverlay"></div>
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-head">
    <span class="cart-head-title">Carrinho (<span id="cartDrawerCount">{{ cart.item_count }}</span>)</span>
    <button class="cart-close" id="cartClose">✕</button>
  </div>
  <div class="cart-body" id="cartDrawerBody">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#2a2a2a" stroke-width="1"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    <p class="cart-empty-label">Seu carrinho está vazio</p>
  </div>
  <div class="cart-foot">
    <a href="{{ routes.cart_url }}" class="cart-shop-link">Ver carrinho completo</a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texto do logo",
      "default": "LGD"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu de navegação (ex: Lookbook)",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "nav_shop",
      "label": "Label: Shop",
      "default": "SHOP"
    },
    {
      "type": "url",
      "id": "lookbook_url",
      "label": "Link da página Lookbook",
      "info": "Crie uma página com o template \"lookbook\" e cole o link dela aqui (ex: /pages/lookbook)",
      "default": "/pages/lookbook"
    },
    {
      "type": "text",
      "id": "nav_lookbook",
      "label": "Label: Lookbook",
      "default": "LOOKBOOK"
    },
    {
      "type": "header",
      "content": "Barra de anúncio"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostrar barra de anúncio",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto (rola em loop)",
      "default": "FRETE GRÁTIS ACIMA DE R$250 · 5% OFF NO PIX · 2X SEM JUROS"
    }
  ]
}
{% endschema %}

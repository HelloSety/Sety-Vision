<div class="pw-page">
  <div class="pw-bg">
    {%- if section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 1920 }}" alt="" fetchpriority="high" width="1920" height="1080">
    {%- elsif settings.password_hero_image != blank -%}
      <img src="{{ settings.password_hero_image | image_url: width: 1920 }}" alt="" fetchpriority="high" width="1920" height="1080">
    {%- endif -%}
    <div class="pw-bg-overlay"></div>
  </div>

  <div class="pw-content">
    {%- if settings.logo != blank -%}
      <img class="pw-logo" src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="60">
    {%- else -%}
      <p class="pw-logo-text">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="pw-headline">{{ settings.password_headline | default: 'Legacy Company' }}</h1>
    <p class="pw-sub">{{ settings.password_subheadline | default: 'A nova coleção está chegando.' }}</p>

    {%- if settings.password_launch_date != blank -%}
      <div class="pw-countdown" id="pwCountdown" data-target="{{ settings.password_launch_date }}">
        <div class="pw-cd-unit"><span class="pw-cd-n" data-unit="d">00</span><span class="pw-cd-l">dias</span></div>
        <div class="pw-cd-unit"><span class="pw-cd-n" data-unit="h">00</span><span class="pw-cd-l">horas</span></div>
        <div class="pw-cd-unit"><span class="pw-cd-n" data-unit="m">00</span><span class="pw-cd-l">min</span></div>
        <div class="pw-cd-unit"><span class="pw-cd-n" data-unit="s">00</span><span class="pw-cd-l">seg</span></div>
      </div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'pw-form' -%}
      {%- if form.errors -%}
        <p class="pw-error">Senha incorreta. Tente novamente.</p>
      {%- endif -%}
      <input class="pw-input" type="password" name="password" placeholder="Digite a senha" autocomplete="current-password" required>
      <button class="pw-btn" type="submit">Entrar</button>
    {%- endform -%}

    <div class="pw-divider"><span>ou</span></div>

    <a class="pw-wpp-btn" href="https://wa.me/{{ settings.wpp_number }}?text={{ settings.password_wpp_message | url_encode }}" target="_blank" rel="noopener">
      {%- render 'icon-whatsapp' -%}
      Falar no WhatsApp
    </a>

    <div class="pw-vip" id="pwVip">
      <p class="pw-vip-label">Receba acesso antecipado — digite seu WhatsApp</p>
      {%- form 'customer', id: 'pwVipForm', class: 'pw-vip-form' -%}
        <input type="hidden" name="contact[tags]" value="lista-vip-legacy">
        {%- if form.posted_successfully? -%}
          <p class="pw-vip-success">Recebemos seu contato — te avisamos assim que abrir.</p>
        {%- else -%}
          <input class="pw-vip-input" type="tel" name="contact[phone]" placeholder="(85) 90000-0000" required autocomplete="tel">
          <button class="pw-vip-submit" type="submit">Enviar</button>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="pw-benefits">
      <span>✓ Atendimento rápido</span>
      <span>✓ Produtos premium</span>
      <span>✓ Frete para todo o Brasil</span>
    </div>

    {%- if settings.instagram != blank or settings.tiktok != blank -%}
      <div class="pw-social">
        {%- if settings.instagram != blank -%}
          <a href="https://www.instagram.com/{{ settings.instagram }}/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.tiktok != blank -%}
          <a href="https://www.tiktok.com/@{{ settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82a4.28 4.28 0 0 1-.24-1.4h-3.05v13.3a3.13 3.13 0 1 1-2.2-2.98v-3.1a6.2 6.2 0 1 0 5.25 6.13V9.6a7.3 7.3 0 0 0 4.24 1.35V7.9a4.28 4.28 0 0 1-3.99-2.08z"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <p class="pw-copy">© {{ 'now' | date: '%Y' }} {{ shop.name }} — Todos os direitos reservados.</p>
  </div>
</div>

<style>
  .template-password .skip-link, .template-password .wpp-float { display: none; }
  .pw-page { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 60px 20px; }
  .pw-bg { position: fixed; inset: 0; z-index: 0; background: #000; }
  .pw-bg img { width: 100%; height: 100%; object-fit: cover; filter: blur(22px) brightness(.32) saturate(.7); transform: scale(1.1); opacity: 0; animation: pwFadeIn 1.2s ease forwards; }
  .pw-bg-overlay { position: absolute; inset: 0; background: radial-gradient(circle at 50% 40%, rgba(0,0,0,.2), rgba(0,0,0,.75)); }
  @keyframes pwFadeIn { to { opacity: 1; } }

  .pw-content { position: relative; z-index: 1; width: min(400px, 92vw); text-align: center; display: flex; flex-direction: column; align-items: center; opacity: 0; transform: translateY(14px); animation: pwRise .8s cubic-bezier(.16,1,.3,1) .15s forwards; }
  @keyframes pwRise { to { opacity: 1; transform: translateY(0); } }

  .pw-logo { height: 40px; width: auto; margin-bottom: 28px; opacity: .96; }
  .pw-logo-text { font-size: 13px; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; margin-bottom: 28px; }
  .pw-headline { font-size: clamp(24px, 5vw, 34px); font-weight: 700; letter-spacing: .02em; margin-bottom: 8px; }
  .pw-sub { font-size: 13px; color: var(--gray); letter-spacing: .04em; margin-bottom: 28px; }

  .pw-countdown { display: flex; gap: 18px; margin-bottom: 32px; }
  .pw-cd-unit { display: flex; flex-direction: column; align-items: center; min-width: 44px; }
  .pw-cd-n { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .pw-cd-l { font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--gray2); margin-top: 4px; }

  .pw-form { display: flex; width: 100%; border: 1px solid rgba(255,255,255,.18); margin-bottom: 22px; }
  .pw-input { flex: 1; background: rgba(255,255,255,.04); border: none; padding: 15px 16px; color: #fff; font-size: 13px; font-family: 'Inter', sans-serif; outline: none; }
  .pw-input::placeholder { color: rgba(255,255,255,.32); }
  .pw-btn { background: #fff; color: #000; border: none; padding: 0 24px; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; cursor: pointer; transition: opacity .2s; }
  .pw-btn:hover { opacity: .85; }
  .pw-error { color: var(--pix); font-size: 11px; margin-bottom: 12px; }

  .pw-divider { display: flex; align-items: center; gap: 12px; width: 100%; color: var(--gray2); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 20px; }
  .pw-divider::before, .pw-divider::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.12); }

  .pw-wpp-btn { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 15px; background: #25D366; color: #000; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 28px; transition: opacity .2s; border-radius: 2px; }
  .pw-wpp-btn svg { width: 18px; height: 18px; fill: #000; }
  .pw-wpp-btn:hover { opacity: .88; }

  .pw-vip { width: 100%; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); margin-bottom: 20px; }
  .pw-vip-label { font-size: 11px; color: var(--gray); letter-spacing: .03em; margin-bottom: 12px; }
  .pw-vip-form { display: flex; border-bottom: 1px solid rgba(255,255,255,.2); }
  .pw-vip-input { flex: 1; background: none; border: none; color: #fff; font-family: 'Inter', sans-serif; font-size: 12px; padding: 10px 0; outline: none; }
  .pw-vip-input::placeholder { color: rgba(255,255,255,.3); }
  .pw-vip-submit { background: none; border: none; color: var(--gray); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; padding: 10px 0 10px 14px; transition: color .2s; }
  .pw-vip-submit:hover { color: #fff; }
  .pw-vip-success { font-size: 11px; color: var(--pix); }

  .pw-benefits { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; font-size: 10px; color: var(--gray2); letter-spacing: .03em; margin-bottom: 24px; }

  .pw-social { display: flex; gap: 16px; margin-bottom: 18px; color: var(--gray); }
  .pw-social a { transition: color .2s; }
  .pw-social a:hover { color: #fff; }

  .pw-copy { font-size: 10px; color: var(--gray2); letter-spacing: .04em; }

  @media (max-width: 480px) {
    .pw-countdown { gap: 12px; }
    .pw-cd-unit { min-width: 38px; }
  }
</style>

<script>
  (function () {
    var el = document.getElementById('pwCountdown');
    if (!el) return;
    var target = new Date(el.dataset.target).getTime();
    if (isNaN(target)) { el.style.display = 'none'; return; }
    function tick() {
      var diff = target - Date.now();
      if (diff <= 0) { el.style.display = 'none'; return; }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.querySelector('[data-unit="d"]').textContent = String(d).padStart(2, '0');
      el.querySelector('[data-unit="h"]').textContent = String(h).padStart(2, '0');
      el.querySelector('[data-unit="m"]').textContent = String(m).padStart(2, '0');
      el.querySelector('[data-unit="s"]').textContent = String(s).padStart(2, '0');
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

{% schema %}
{
  "name": "Página de senha",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Imagem de fundo (sobrepõe a padrão em Tema > Página de Senha)" }
  ]
}
{% endschema %}

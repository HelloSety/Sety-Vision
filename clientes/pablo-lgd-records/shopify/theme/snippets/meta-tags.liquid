{%- comment -%} Open Graph, Twitter Card e JSON-LD — só o essencial por tipo de página {%- endcomment -%}

{%- if template == 'product' -%}
  {%- assign og_title = product.title -%}
  {%- assign og_description = product.description | strip_html | truncate: 160 -%}
  {%- assign og_image = product.featured_image | image_url: width: 1200 -%}
  {%- assign og_type = 'product' -%}
{%- elsif template == 'collection' -%}
  {%- assign og_title = collection.title -%}
  {%- assign og_description = collection.description | strip_html | truncate: 160 | default: settings.seo_default_description -%}
  {%- assign og_image = collection.image | image_url: width: 1200 -%}
  {%- assign og_type = 'website' -%}
{%- else -%}
  {%- assign og_title = page_title | default: shop.name -%}
  {%- assign og_description = page_description | default: settings.seo_default_description -%}
  {%- assign og_image = settings.social_share_image | image_url: width: 1200 -%}
  {%- assign og_type = 'website' -%}
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}<meta property="og:description" content="{{ og_description | escape }}">{%- endif -%}
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image != blank -%}<meta property="og:image" content="https:{{ og_image }}">{%- endif -%}
<meta property="og:locale" content="pt_BR">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}<meta name="twitter:description" content="{{ og_description | escape }}">{%- endif -%}
{%- if og_image != blank -%}<meta name="twitter:image" content="https:{{ og_image }}">{%- endif -%}

{%- if template == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "image": [{%- for image in product.images limit: 5 -%}"https:{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{%- endfor -%}],
    "description": {{ product.description | strip_html | truncate: 300 | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "brand": { "@type": "Brand", "name": "LGD Records" },
    "offers": {
      "@type": "Offer",
      "url": {{ canonical_url | json }},
      "priceCurrency": "BRL",
      "price": {{ product.price | money_without_currency | json }},
      "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
    }
  }
  </script>
{%- elsif template == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Organization",
    "name": "LGD Records",
    "url": {{ shop.url | json }},
    "logo": "https:{{ settings.logo | image_url: width: 300 }}",
    "sameAs": [
      {%- if settings.instagram != blank -%}"https://www.instagram.com/{{ settings.instagram }}/"{%- endif -%}
    ]
  }
  </script>
{%- endif -%}

{%- if template == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Shop", "item": {{ routes.all_products_collection_url | prepend: shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
    ]
  }
  </script>
{%- endif -%}

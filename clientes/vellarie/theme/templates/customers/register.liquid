<section class="section">
  <div class="container" style="max-width:420px">
    <h1 class="h2" style="margin-bottom:1.5rem">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<p class="form-note form-note--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="form-field"><label for="rFirst">{{ 'customer.register.first_name' | t }}</label><input type="text" id="rFirst" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="form-field"><label for="rLast">{{ 'customer.register.last_name' | t }}</label><input type="text" id="rLast" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="form-field"><label for="rEmail">{{ 'customer.register.email' | t }}</label><input type="email" id="rEmail" name="customer[email]" autocomplete="email" required></div>
      <div class="form-field"><label for="rPass">{{ 'customer.register.password' | t }}</label><input type="password" id="rPass" name="customer[password]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--full" style="margin-top:1rem">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
    <p style="margin-top:1.5rem" class="text-muted"><a href="{{ routes.account_login_url }}" class="link-underline">{{ 'customer.register.has_account' | default: 'Already have an account?' }}</a></p>
  </div>
</section>

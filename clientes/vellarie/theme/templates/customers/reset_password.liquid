<section class="section">
  <div class="container" style="max-width:420px">
    <h1 class="h2" style="margin-bottom:1.5rem">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form-note form-note--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="form-field"><label for="rpPass">{{ 'customer.reset_password.password' | t }}</label><input type="password" id="rpPass" name="customer[password]" autocomplete="new-password" required></div>
      <div class="form-field"><label for="rpConf">{{ 'customer.reset_password.password_confirmation' | t }}</label><input type="password" id="rpConf" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

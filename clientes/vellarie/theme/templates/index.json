{
  "sections": {
    "hero": {
      "type": "hero",
      "settings": {
        "height": "standard",
        "desktop_ratio": "3 / 1",
        "mobile_ratio": "40 / 63",
        "max_height": 720,
        "focus": "50% 50%",
        "overlay": "none",
        "show_dots": true,
        "autoplay": 7
      },
      "blocks": {
        "s1": {
          "type": "slide",
          "settings": {
            "default_asset": "hero-a",
            "text_source": "baked",
            "heading": "Premium beauty & grooming essentials",
            "cta_label": "",
            "cta_link": "shopify://collections/best-sellers",
            "cta_style": "pill"
          }
        },
        "s2": {
          "type": "slide",
          "settings": {
            "default_asset": "hero-b",
            "text_source": "baked",
            "heading": "Elevate your beauty, every day",
            "cta_label": "",
            "cta_link": "shopify://collections/best-sellers",
            "cta_style": "pill"
          }
        }
      },
      "block_order": ["s1", "s2"]
    },
    "marquee": {
      "type": "marquee",
      "settings": { "style": "dark", "aria": "Store highlights" },
      "blocks": {
        "m1": { "type": "item", "settings": { "text": "Free US shipping over $75" } },
        "m2": { "type": "item", "settings": { "text": "30-day returns" } },
        "m3": { "type": "item", "settings": { "text": "Secure checkout" } },
        "m4": { "type": "item", "settings": { "text": "Shop Vellarie" } }
      },
      "block_order": ["m1", "m2", "m3", "m4"]
    },
    "trust": {
      "type": "trust-bar",
      "blocks": {
        "b1": { "type": "item", "settings": { "icon": "shipping", "title": "Free US shipping", "text": "On orders over $75" } },
        "b2": { "type": "item", "settings": { "icon": "return", "title": "30-day returns", "text": "Easy and no-hassle" } },
        "b3": { "type": "item", "settings": { "icon": "shield", "title": "1-year warranty", "text": "On every device" } },
        "b4": { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Encrypted & protected" } }
      },
      "block_order": ["b1", "b2", "b3", "b4"]
    },
    "bestsellers": {
      "type": "featured-collection",
      "settings": {
        "heading": "Best sellers",
        "collection": "best-sellers",
        "products_to_show": 8,
        "show_view_all": true,
        "color_scheme": ""
      }
    },
    "categories": {
      "type": "category-index",
      "settings": { "heading": "Shop by category", "color_scheme": "color-dark" },
      "blocks": {
        "c1": { "type": "item", "settings": { "collection": "best-sellers", "label": "Grooming", "sub": "Shavers, trimmers & precision tools", "link": "shopify://collections/best-sellers" } },
        "c2": { "type": "item", "settings": { "collection": "best-offers", "label": "Hair & Styling", "sub": "Brushes, irons & scalp care", "link": "shopify://collections/best-offers" } },
        "c3": { "type": "item", "settings": { "collection": "free-shipping", "label": "Skin & Body", "sub": "Cleansing & beauty devices", "link": "shopify://collections/free-shipping" } },
        "c4": { "type": "item", "settings": { "collection": "best-sellers", "label": "Recovery & Relief", "sub": "Massage & red-light therapy", "link": "shopify://collections/best-sellers" } }
      },
      "block_order": ["c1", "c2", "c3", "c4"]
    },
    "campaign": {
      "type": "campaign-feature",
      "settings": {
        "default_asset": "hair",
        "media_position": "left",
        "eyebrow": "Designed for your routine",
        "heading": "Precision technology. Everyday performance.",
        "text": "Tools that feel considered in the hand and hold up over years of daily use. No shortcuts, no gimmicks.",
        "cta_label": "Explore the collection",
        "cta_link": "shopify://collections/best-sellers",
        "color_scheme": "color-surface"
      }
    },
    "newarrivals": {
      "type": "featured-collection",
      "settings": {
        "heading": "New arrivals",
        "collection": "best-offers",
        "products_to_show": 4,
        "show_view_all": true,
        "color_scheme": ""
      }
    },
    "brandstory": {
      "type": "editorial-split",
      "settings": {
        "eyebrow": "The Vellarie standard",
        "heading": "Salon results, at home",
        "text": "<p>Precision motors, durable materials, and a finish built to last. Every device earns its place on your counter.</p>",
        "cta_label": "About Vellarie",
        "cta_link": "shopify://collections/best-sellers",
        "default_asset": "grooming",
        "reverse": true
      }
    },
    "testimonials": {
      "type": "testimonials",
      "settings": {
        "heading": "Customer reviews",
        "columns": "3",
        "show_summary": false,
        "rating": 0,
        "review_count": "",
        "empty_note": "Verified customer reviews will appear here once your reviews app is connected.",
        "color_scheme": "color-surface"
      }
    },
    "promo": {
      "type": "promo-banner",
      "settings": {
        "layout": "split",
        "default_asset": "hero-b",
        "eyebrow": "The kit",
        "heading": "Build your grooming routine",
        "text": "Pair a shaver, a styler and a recovery tool — everything you reach for, in one order.",
        "end_date": "",
        "cta_label": "Shop best sellers",
        "cta_link": "shopify://collections/best-sellers"
      }
    }
  },
  "order": [
    "hero",
    "marquee",
    "trust",
    "bestsellers",
    "categories",
    "campaign",
    "newarrivals",
    "brandstory",
    "testimonials",
    "promo"
  ]

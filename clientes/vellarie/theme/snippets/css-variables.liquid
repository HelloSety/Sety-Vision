{%- comment -%}
  Maps theme settings -> CSS custom properties + loads the selected web fonts.
  Two families: heading (display) + body (UI/text). Each can be a curated Google
  font or the Shopify font picker.
{%- endcomment -%}

{%- liquid
  assign google_families = '' | split: ''

  case settings.heading_font_family
    when 'archivo'
      assign heading_stack = "'Archivo', 'Helvetica Neue', Arial, sans-serif"
      assign google_families = google_families | concat: 'Archivo:wght@400;500;600;700;800;900' | split: '~~~'
    when 'space-grotesk'
      assign heading_stack = "'Space Grotesk', 'Helvetica Neue', Arial, sans-serif"
      assign google_families = google_families | concat: 'Space+Grotesk:wght@400;500;600;700' | split: '~~~'
    when 'anton'
      assign heading_stack = "'Anton', 'Arial Narrow', Arial, sans-serif"
      assign google_families = google_families | concat: 'Anton' | split: '~~~'
    when 'cinzel'
      assign heading_stack = "'Cinzel', 'Times New Roman', Georgia, serif"
      assign google_families = google_families | concat: 'Cinzel:wght@400;500;600;700' | split: '~~~'
    when 'inter'
      assign heading_stack = "'Inter', 'Helvetica Neue', Arial, sans-serif"
      assign google_families = google_families | concat: 'Inter:wght@400;500;600;700;800' | split: '~~~'
    else
      assign heading_stack = settings.font_heading.family | append: ', ' | append: settings.font_heading.fallback_families
  endcase

  case settings.body_font_family
    when 'inter'
      assign body_stack = "'Inter', 'Helvetica Neue', Arial, sans-serif"
      assign google_families = google_families | concat: 'Inter:wght@300;400;500;600;700' | split: '~~~'
    when 'montserrat'
      assign body_stack = "'Montserrat', 'Helvetica Neue', Arial, sans-serif"
      assign google_families = google_families | concat: 'Montserrat:wght@300;400;500;600;700' | split: '~~~'
    when 'archivo'
      assign body_stack = "'Archivo', 'Helvetica Neue', Arial, sans-serif"
      assign google_families = google_families | concat: 'Archivo:wght@300;400;500;600;700' | split: '~~~'
    else
      assign body_stack = settings.font_body.family | append: ', ' | append: settings.font_body.fallback_families
  endcase

  assign gf_query = ''
  assign seen = '' | split: ''
  for fam in google_families
    unless seen contains fam
      assign seen = seen | concat: fam | split: '~~~'
      if gf_query == ''
        assign gf_query = 'family=' | append: fam
      else
        assign gf_query = gf_query | append: '&family=' | append: fam
      endif
    endunless
  endfor
-%}

{%- if gf_query != '' -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ gf_query }}&display=swap">
{%- endif -%}
{%- if settings.heading_font_family == 'shopify' -%}{{ settings.font_heading | font_face: font_display: 'swap' }}{%- endif -%}
{%- if settings.body_font_family == 'shopify' -%}{{ settings.font_body | font_face: font_display: 'swap' }}{%- endif -%}

<style>
  :root {
    --color-bg: {{ settings.color_bg }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-text-muted: {{ settings.color_text_muted }};
    --color-line-rgb: {{ settings.color_line | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --color-line: rgba(var(--color-line-rgb), 0.16);
    --color-line-strong: rgba(var(--color-line-rgb), 0.5);

    --color-bg-dark: {{ settings.color_bg_dark }};
    --color-surface-dark: {{ settings.color_surface_dark }};
    --color-text-dark: {{ settings.color_text_dark }};
    --color-text-muted-dark: {{ settings.color_text_muted_dark }};

    --color-accent: {{ settings.color_accent }};
    --color-accent-contrast: {{ settings.color_accent_contrast }};
    --color-accent-dark: {{ settings.color_accent_dark | default: '#FFFFFF' }};
    --color-accent-contrast-dark: {{ settings.color_accent_contrast_dark | default: '#0A0A0A' }};
    --color-accent-alt: {{ settings.color_accent_alt | default: settings.color_accent }};
    --color-accent-rgb: {{ settings.color_accent_dark | default: settings.color_accent | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --color-sale: {{ settings.color_sale }};

    --font-heading: {{ heading_stack }};
    --font-body: {{ body_stack }};
    --type-scale: {{ settings.type_scale | divided_by: 100.0 }};
    --heading-tracking: {{ settings.heading_letter_spacing | divided_by: 100.0 }}rem;
    --heading-case: {{ settings.heading_case }};
    --body-size: {{ settings.body_font_size }}px;

    --container: {{ settings.container_width }}px;
    --gutter: {{ settings.gutter }}px;
    --section-space: {{ settings.section_spacing }}px;
    --section-space-mobile: {{ settings.section_spacing_mobile }}px;
    --radius: {{ settings.corner_radius }}px;

    --btn-tracking: {{ settings.button_letter_spacing | divided_by: 100.0 }}rem;
    --btn-radius: {{ settings.button_radius }}px;
    --btn-case: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};

    --card-ratio: {% case settings.card_image_ratio %}{% when 'square' %}1 / 1{% when 'natural' %}auto{% else %}3 / 4{% endcase %};

    --card-radius: {{ settings.corner_radius | plus: 4 }}px;
    --shadow-1: 0 1px 2px rgba(10,10,12,0.06), 0 8px 24px rgba(10,10,12,0.06);
    --shadow-2: 0 24px 60px -20px rgba(10,10,12,0.35);
    --glow: 0 0 0 1px rgba(var(--color-accent-rgb), 0.35), 0 18px 50px -12px rgba(var(--color-accent-rgb), 0.45);

    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --dur-fast: 200ms;
    --dur: 400ms;
    --dur-slow: 720ms;

    --header-h: 72px;
  }
</style>

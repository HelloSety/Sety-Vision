{%- comment -%}
  Usage: {% render 'icon', name: 'cart', class: 'header-icon' %}
  Line icons, 24x24, stroke = currentColor.
{%- endcomment -%}
{%- liquid
  assign n = name | default: 'arrow'
  assign cls = class | default: 'icon'
-%}
<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case n -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>
    {%- when 'cart' -%}<path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/>
    {%- when 'bag' -%}<path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/>
    {%- when 'menu' -%}<path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'chevron-down' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-left' -%}<path d="M15 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}<path d="M9 6l6 6-6 6"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'shipping' -%}<path d="M3 7h11v10H3zM14 10h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
    {%- when 'shield' -%}<path d="M12 3l7 3v6c0 5-3 7-7 9-4-2-7-4-7-9V6l7-3Z"/><path d="M9.5 12l2 2 3.5-4"/>
    {%- when 'return' -%}<path d="M4 12a8 8 0 1 1 2.3 5.6"/><path d="M4 20v-5h5"/>
    {%- when 'card' -%}<rect x="3" y="6" width="18" height="12" rx="1"/><path d="M3 10h18"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'star' -%}<path d="M12 3l2.7 5.7 6.3.9-4.6 4.4 1.1 6.3L12 17.8 6.5 20.3l1.1-6.3L3 9.6l6.3-.9L12 3Z"/>
    {%- when 'filter' -%}<path d="M3 5h18M6 12h12M10 19h4"/>
    {%- when 'sort' -%}<path d="M7 4v16M7 20l-3-3M7 4l3 3M17 20V4M17 4l-3 3M17 4l3 3"/>
    {%- when 'instagram' -%}<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17" cy="7" r="1"/>
    {%- when 'tiktok' -%}<path d="M15 4c0 3 2 5 5 5v3c-2 0-4-.7-5-1.6V15a6 6 0 1 1-6-6c.4 0 .7 0 1 .1v3.1A3 3 0 1 0 12 15V4h3Z"/>
    {%- when 'facebook' -%}<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8a1 1 0 0 1 1-1Z"/>

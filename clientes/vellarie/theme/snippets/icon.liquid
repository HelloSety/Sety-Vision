    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="M12 8c-2 0-3 1.4-3 3 0 1 .4 2 1.2 2.4M12 8c2.2 0 3.4 1.6 3 3.6-.3 1.7-1.6 2.6-2.8 2.4-.9-.2-1.4-1-1.2-2M11 15l-1 4"/>
    {%- else -%}<path d="M5 12h14M13 6l6 6-6 6"/>
  {%- endcase -%}
</svg>

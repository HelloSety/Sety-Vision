{%- comment -%} Params: product ; block (for shopify_attributes) {%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign dn = option.name | downcase
        assign is_color = false
        if dn contains 'cor' or dn contains 'color' or dn contains 'colour'
          assign is_color = true
        endif
        assign is_size = false
        if dn contains 'tam' or dn contains 'size'
          assign is_size = true
        endif
        assign selected = option.selected_value
      -%}
      <div class="opt" data-opt="{{ option.name | escape }}">
        <span class="opt__label">
          <span>{{ option.name }}: <span class="selected" data-opt-selected>{{ selected }}</span></span>
          {%- if is_size and product.metafields.custom.size_guide != blank -%}
            <button type="button" class="size-guide-link" data-open-size-guide>{{ 'products.product.size_guide' | t }}</button>
          {%- endif -%}
        </span>
        <div class="opt__values">
          {%- for value in option.values -%}
            <button
              type="button"
              class="opt__value{% if is_color %} opt__value--swatch{% endif %}"
              data-opt-value="{{ value | escape }}"
              aria-pressed="{% if value == selected %}true{% else %}false{% endif %}"
              {% if is_color %}style="background-color:{{ value | split: ' ' | last | downcase }}"{% endif %}
              aria-label="{{ option.name }}: {{ value }}">
              {%- unless is_color -%}{{ value }}{%- endunless -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endunless -%}

<script type="application/json" data-pdp-variants
  data-title="{{ product.title | escape }}"
  data-sku="{{ product.selected_or_first_available_variant.sku }}"
  data-price="{{ product.price | divided_by: 100.0 }}">
  [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "options": {{ v.options | json }},
        "price": {{ v.price }},
        "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
        "available": {{ v.available }},
        "sku": {{ v.sku | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

{%- comment -%} Params: product {%- endcomment -%}
{%- liquid
  assign mf_key = settings.badge_new_metafield | split: '.'
  assign ns = mf_key[0]
  assign key = mf_key[1]
  assign custom_badge = product.metafields[ns][key].value
-%}
<div class="card__badges">
  {%- if product.available == false -%}
    <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
  {%- elsif product.compare_at_price > product.price -%}
    {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
    <span class="badge badge--sale">-{{ pct }}%</span>
  {%- endif -%}
  {%- if custom_badge != blank -%}
    <span class="badge">{{ custom_badge }}</span>
  {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
    <span class="badge">{{ 'products.product.badge_new' | t }}</span>
  {%- endif -%}
</div>

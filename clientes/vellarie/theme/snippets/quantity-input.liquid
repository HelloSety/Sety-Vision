{%- comment -%} Params: id (default 'Qty'), name (default 'quantity'), value (default 1), key {%- endcomment -%}
<div class="qty" data-qty {% if key %}data-line-qty{% endif %}>
  <button type="button" data-dir="down" aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', name: 'minus', class: 'icon' %}</button>
  <input
    type="number"
    id="{{ id | default: 'Qty' }}"
    name="{{ name | default: 'quantity' }}"
    value="{{ value | default: 1 }}"
    min="{% if key %}0{% else %}1{% endif %}"
    inputmode="numeric"
    {% if key %}data-key="{{ key }}"{% endif %}
    aria-label="{{ 'products.product.quantity.label' | t }}">
  <button type="button" data-dir="up" aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', name: 'plus', class: 'icon' %}</button>
</div>

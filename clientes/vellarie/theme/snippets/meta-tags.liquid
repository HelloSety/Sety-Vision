{%- comment -%} Open Graph + Twitter cards + JSON-LD. {%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_desc = page_description | default: shop.description | default: shop.name
  assign og_image = settings.social_share_image | default: page_image
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:card" content="summary_large_image">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | strip_html | truncate: 200 | escape }}">

{%- if request.page_type == 'product' and product -%}
  {% render 'structured-data', type: 'product', product: product %}
{%- elsif request.page_type == 'index' -%}
  {% render 'structured-data', type: 'organization' %}
  {% render 'structured-data', type: 'website' %}
{%- elsif request.page_type == 'collection' and collection -%}
  {% render 'structured-data', type: 'collection', collection: collection %}
{%- endif -%}

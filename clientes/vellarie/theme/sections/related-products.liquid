{%- liquid
  assign limit = section.settings.products_to_show
-%}
{%- if section.settings.enable and recommendations.performed and recommendations.products_count > 0 -%}
  <section class="section {{ section.settings.color_scheme }}">
    <div class="container">
      <div class="section-head" data-reveal><h2 class="section-head__title">{{ section.settings.heading }}</h2></div>
      <div class="grid--products" data-reveal-stagger>
        {%- for product in recommendations.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif section.settings.enable -%}
  <section class="section {{ section.settings.color_scheme }}"
    data-related-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}">
    <div class="container"><div class="section-head"><h2 class="section-head__title">{{ section.settings.heading }}</h2></div></div>
    <script>
      (function(){
        var s=document.currentScript.closest('section');
        fetch(s.dataset.relatedUrl).then(function(r){return r.text();}).then(function(h){
          var d=new DOMParser().parseFromString(h,'text/html').querySelector('.container');
          if(d) s.querySelector('.container').innerHTML=d.innerHTML;
        });
      })();
    </script>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.related_products.name",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "t:sections.related_products.enable", "default": true },
    { "type": "text", "id": "heading", "label": "t:sections.related_products.heading", "default": "You may also like" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "t:sections.featured_collection.products_to_show", "default": 4 },
    { "type": "select", "id": "color_scheme", "label": "t:settings.color_scheme.label", "options": [
      { "value": "", "label": "t:settings.color_scheme.light" },
      { "value": "color-surface", "label": "t:settings.color_scheme.surface" }
    ], "default": "color-surface" }
  ],
  "presets": [ { "name": "t:sections.related_products.name" } ]
}
{% endschema %}

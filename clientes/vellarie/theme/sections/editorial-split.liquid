<section class="editorial{% if section.settings.reverse %} editorial--reverse{% endif %}" data-reveal>
  <div class="editorial__text">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="editorial__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div><a class="btn" href="{{ section.settings.cta_link }}" style="--color-accent:#fff;--color-accent-contrast:#0a0a0a">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
  <div class="editorial__media" data-parallax>
    {%- liquid
      assign ed_asset = ''
      case section.settings.default_asset
        when 'hero-a'
          assign ed_asset = 'hero-a-desktop'
        when 'hero-b'
          assign ed_asset = 'hero-b-desktop'
        when 'grooming'
          assign ed_asset = 'cat-grooming'
        when 'hair'
          assign ed_asset = 'cat-hair'
      endcase
    -%}
    {%- if section.settings.image -%}
      {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 900px) 50vw, 100vw' %}
    {%- elsif ed_asset != blank -%}
      <picture>
        <source type="image/webp" srcset="{{ ed_asset | append: '.webp' | asset_url }}">
        <img src="{{ ed_asset | append: '.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1600" height="1200" loading="lazy">
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.editorial_split.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.editorial_split.eyebrow", "default": "Limited drop" },
    { "type": "text", "id": "heading", "label": "t:sections.editorial_split.heading", "default": "Shadow System" },
    { "type": "richtext", "id": "text", "label": "t:sections.editorial_split.text", "default": "<p>A collection built on contrast, engineered for the street.</p>" },
    { "type": "text", "id": "cta_label", "label": "t:sections.editorial_split.cta_label", "default": "Shop the drop" },
    { "type": "url", "id": "cta_link", "label": "t:sections.editorial_split.cta_link" },
    { "type": "image_picker", "id": "image", "label": "t:sections.editorial_split.image" },
    { "type": "select", "id": "default_asset", "label": "Built-in image (fallback)", "options": [
      { "value": "none", "label": "None" },
      { "value": "hero-a", "label": "Campaign A — Grooming (blue)" },
      { "value": "hero-b", "label": "Campaign B — Hair (green)" },
      { "value": "grooming", "label": "Grooming close-up" },
      { "value": "hair", "label": "Hair close-up" }
    ], "default": "none" },
    { "type": "checkbox", "id": "reverse", "label": "t:sections.editorial_split.reverse", "default": false }
  ],
  "presets": [ { "name": "t:sections.editorial_split.name" } ]
}
{% endschema %}

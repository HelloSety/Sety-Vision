{%- liquid
  assign blocks = section.blocks
  assign cols = section.settings.columns
  assign baked = false
  if section.settings.text_source == 'baked'
    assign baked = true
  endif
-%}
<section class="section {{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head" data-reveal><h2 class="section-head__title">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="cat-grid cat-grid--{{ cols }}{% if baked %} cat-grid--baked{% endif %}" data-reveal-stagger>
      {%- for block in blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign bundled = ''
          assign bw = 1100
          assign bh = 1375
          case block.settings.default_asset
            when 'grooming'
              assign bundled = 'cat-grooming'
            when 'hair'
              assign bundled = 'cat-hair'
            when 'tile-beauty'
              assign bundled = 'cat-tile-beauty'
              assign bw = 620
              assign bh = 715
            when 'tile-grooming'
              assign bundled = 'cat-tile-grooming'
              assign bw = 620
              assign bh = 715
            when 'tile-accessories'
              assign bundled = 'cat-tile-accessories'
              assign bw = 620
              assign bh = 715
            when 'tile-new'
              assign bundled = 'cat-tile-new'
              assign bw = 620
              assign bh = 715
            when 'tile-best'
              assign bundled = 'cat-tile-best-sellers'
              assign bw = 620
              assign bh = 715
          endcase
          assign cat_url = coll.url | default: block.settings.link | default: routes.all_products_collection_url
          assign cat_label = block.settings.title | default: coll.title | default: 'Shop'
        -%}
        <a class="cat-card cat-card--tall{% if baked %} cat-card--baked{% endif %}" href="{{ cat_url }}" {{ block.shopify_attributes }}>
          <span class="cat-card__media">
            {%- assign img = block.settings.image | default: coll.featured_image -%}
            {%- if img -%}
              {% render 'responsive-image', image: img, sizes: '(min-width: 750px) 33vw, 90vw' %}
            {%- elsif bundled != blank -%}
              <picture>
                <source type="image/webp" srcset="{{ bundled | append: '.webp' | asset_url }}">
                <img src="{{ bundled | append: '.jpg' | asset_url }}" alt="{{ cat_label | escape }}" width="{{ bw }}" height="{{ bh }}" loading="lazy">
              </picture>
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          {%- if baked -%}
            <span class="visually-hidden">{{ cat_label }}</span>
          {%- else -%}
            <span class="cat-card__body{% if section.settings.overlay_text %} cat-card__body--overlay{% endif %}">
              <span class="cat-card__title">{{ cat_label }}</span>
              {%- if coll.all_products_count > 0 -%}
                <span class="cat-card__count">{{ 'sections.collection_list.count' | t: count: coll.all_products_count }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.collection_list.heading", "default": "Shop by category" },
    { "type": "select", "id": "columns", "label": "t:sections.collection_list.columns", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ], "default": "3" },
    { "type": "select", "id": "text_source", "label": "Labels", "options": [
      { "value": "overlay", "label": "Show label over the image" },
      { "value": "baked", "label": "Label is in the image (image only)" }
    ], "default": "overlay" },
    { "type": "checkbox", "id": "overlay_text", "label": "t:sections.collection_list.overlay_text", "default": true },
    { "type": "select", "id": "color_scheme", "label": "t:settings.color_scheme.label", "options": [
      { "value": "", "label": "t:settings.color_scheme.light" },
      { "value": "color-surface", "label": "t:settings.color_scheme.surface" },
      { "value": "color-dark", "label": "t:settings.color_scheme.dark" }
    ], "default": "" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.block",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.collection_list.collection" },
        { "type": "image_picker", "id": "image", "label": "t:sections.collection_list.image", "info": "t:sections.collection_list.image_info" },
        { "type": "select", "id": "default_asset", "label": "Built-in image (fallback)", "options": [
          { "value": "none", "label": "None" },
          { "value": "tile-beauty", "label": "Tile — Beauty" },
          { "value": "tile-grooming", "label": "Tile — Grooming" },
          { "value": "tile-accessories", "label": "Tile — Accessories" },
          { "value": "tile-new", "label": "Tile — New Arrivals" },
          { "value": "tile-best", "label": "Tile — Best Sellers" },
          { "value": "grooming", "label": "Grooming close-up (blue)" },
          { "value": "hair", "label": "Hair close-up (green)" }
        ], "default": "none" },
        { "type": "text", "id": "title", "label": "t:sections.collection_list.title_override" },
        { "type": "url", "id": "link", "label": "t:sections.collection_list.link_override", "info": "Point at a real collection. Used when no Collection is selected above." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "t:sections.collection_list.name", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] }
  ]
}
{% endschema %}

{%- liquid
  assign asset = ''
  case section.settings.default_asset
    when 'hero-a'
      assign asset = 'hero-a-desktop'
    when 'hero-b'
      assign asset = 'hero-b-desktop'
  endcase
-%}
<section class="section section--flush" data-reveal>
  <div class="promo">
    <div class="promo__bg" data-parallax>
      {%- if section.settings.image != blank -%}
        {% render 'responsive-image', image: section.settings.image, sizes: '100vw' %}
      {%- elsif asset != blank -%}
        <picture>
          <source type="image/webp" srcset="{{ asset | append: '.webp' | asset_url }}">
          <img src="{{ asset | append: '.jpg' | asset_url }}" alt="" width="1800" height="600" loading="lazy">
        </picture>
      {%- else -%}
        <div style="position:absolute;inset:0;background:var(--color-bg-dark)"></div>
      {%- endif -%}
    </div>

    <div class="promo__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:rgba(255,255,255,0.8)">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="promo__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}

      {%- if section.settings.end_date != blank -%}
        <div class="promo__count" data-countdown="{{ section.settings.end_date }}" hidden>
          <span><b data-cd-d>00</b><span>Days</span></span>
          <span><b data-cd-h>00</b><span>Hrs</span></span>
          <span><b data-cd-m>00</b><span>Min</span></span>
          <span><b data-cd-s>00</b><span>Sec</span></span>
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--pill btn--glow" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "default_asset", "label": "Built-in background", "options": [
      { "value": "none", "label": "None" },
      { "value": "hero-a", "label": "Campaign A — Grooming (blue)" },
      { "value": "hero-b", "label": "Campaign B — Hair (green)" }
    ], "default": "hero-a" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Overrides the built-in background." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & save 20%" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Build your grooming kit — mix any three tools and save at checkout." },
    { "type": "text", "id": "end_date", "label": "Countdown end (optional)", "info": "Format: 2026-12-25T23:59. Leave blank for no countdown. Only use a real deadline.", "default": "" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the bundle" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Promo banner" } ]
}
{% endschema %}

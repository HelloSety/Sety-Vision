{%- liquid
  assign threshold = settings.free_shipping_threshold | plus: 0 | times: 100
  assign remaining = threshold | minus: cart.total_price
-%}
<div class="cart-drawer" data-cart-drawer aria-label="{{ 'sections.cart.title' | t }}" role="dialog" aria-modal="true">
  <div class="cart-drawer__head">
    <h2>{{ 'sections.cart.title' | t }} ({{ cart.item_count }})</h2>
    <button data-cart-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close', class: 'header-icon' %}</button>
  </div>

  {%- if cart.item_count > 0 -%}
    {%- if settings.free_shipping_bar and threshold > 0 -%}
      <div class="cart-drawer__body" style="flex:0;padding-bottom:0">
        <div class="free-ship-bar">
          {%- if remaining > 0 -%}
            {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining | money }}
          {%- else -%}
            {{ 'sections.cart.free_shipping_reached' | t }}
          {%- endif -%}
          <div class="free-ship-bar__track"><div class="free-ship-bar__fill" style="width: {% if remaining > 0 %}{{ cart.total_price | times: 100.0 | divided_by: threshold }}{% else %}100{% endif %}%"></div></div>
        </div>
      </div>
    {%- endif -%}

    <div class="cart-drawer__body">
      {%- for item in cart.items -%}
        <div class="cart-line">
          <a href="{{ item.url }}" class="cart-line__img">
            <img src="{{ item.image | image_url: width: 160 }}" width="76" height="101" alt="{{ item.title | escape }}" loading="lazy">
          </a>
          <div>
            <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}<p class="cart-line__variant">{{ item.variant.title }}</p>{%- endunless -%}
            {%- if item.selling_plan_allocation -%}<p class="cart-line__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
            <p class="cart-line__price">
              {%- if item.original_price != item.final_price -%}
                <span class="price--sale">{{ item.final_price | money }}</span> <span class="price--compare">{{ item.original_price | money }}</span>
              {%- else -%}
                {{ item.final_price | money }}
              {%- endif -%}
            </p>
            {% render 'quantity-input', id: 'CartQty', value: item.quantity, key: item.key %}
            <button class="cart-line__remove" data-line-remove data-key="{{ item.key }}">{{ 'sections.cart.remove' | t }}</button>
          </div>
          <div class="cart-line__price">{{ item.line_price | money }}</div>
        </div>
      {%- endfor -%}
    </div>

    <div class="cart-drawer__foot">
      {%- if settings.cart_note -%}
        <details><summary class="link-underline">{{ 'sections.cart.note' | t }}</summary>
          <textarea name="note" form="CartFooterForm" style="width:100%;margin-top:.5rem;border:1px solid var(--color-line-strong);padding:.6rem">{{ cart.note }}</textarea>
        </details>
      {%- endif -%}
      <div class="cart-subtotal"><span>{{ 'sections.cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
      <p class="cart-taxnote">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
      <form action="{{ routes.cart_url }}" method="post" id="CartFooterForm">
        <button type="submit" name="checkout" class="btn btn--full">{{ 'sections.cart.checkout' | t }}</button>
      </form>
      <a href="{{ routes.all_products_collection_url }}" class="link-underline" style="text-align:center;display:block" data-cart-close>{{ 'sections.cart.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <div class="cart-drawer__body">
      <div class="cart-empty">
        <p class="h3">{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--secondary">{{ 'general.404.link' | t }}</a>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "t:sections.cart.drawer_name", "settings": [] }
{% endschema %}

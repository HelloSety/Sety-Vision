<section class="section" data-section-id="{{ section.id }}">
  <div class="container" style="max-width: 640px">
    <h1 class="h1" data-reveal style="margin-bottom:.5rem">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}<div class="rte text-muted" data-reveal style="margin-bottom:2rem">{{ section.settings.text }}</div>{%- endif -%}

    {%- form 'contact', class: 'contact-form', data-reveal: true -%}
      {%- if form.posted_successfully? -%}
        <p class="form-note form-note--success">{{ 'templates.contact.form.post_success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-note form-note--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="form-field"><label for="cName">{{ 'templates.contact.form.name' | t }}</label><input type="text" id="cName" name="contact[name]" value="{{ form.name }}" required></div>
      <div class="form-field"><label for="cEmail">{{ 'templates.contact.form.email' | t }}</label><input type="email" id="cEmail" name="contact[email]" value="{{ form.email }}" required></div>
      <div class="form-field"><label for="cPhone">{{ 'templates.contact.form.phone' | t }}</label><input type="tel" id="cPhone" name="contact[phone]" value="{{ form.phone }}"></div>
      <div class="form-field"><label for="cBody">{{ 'templates.contact.form.message' | t }}</label><textarea id="cBody" name="contact[body]" rows="5" required>{{ form.body }}</textarea></div>
      <button type="submit" class="btn">{{ 'templates.contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.rich_text.heading", "default": "Contact" },
    { "type": "richtext", "id": "text", "label": "t:sections.rich_text.text" }
  ]
}
{% endschema %}

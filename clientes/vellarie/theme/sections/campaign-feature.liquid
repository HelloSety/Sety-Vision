{%- liquid
  assign asset = ''
  case section.settings.default_asset
    when 'hero-a'
      assign asset = 'hero-a-desktop'
    when 'hero-b'
      assign asset = 'hero-b-desktop'
    when 'grooming'
      assign asset = 'cat-grooming'
    when 'hair'
      assign asset = 'cat-hair'
  endcase
  assign layout = 'cfeat'
  if section.settings.media_position == 'right'
    assign layout = 'cfeat cfeat--right'
  endif
-%}
<section class="section {{ section.settings.color_scheme }}" data-reveal>
  <div class="container">
    <div class="{{ layout }}">
      <div class="cfeat__media">
        {%- if section.settings.image != blank -%}
          {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 900px) 58vw, 100vw' %}
        {%- elsif asset != blank -%}
          <picture>
            <source type="image/webp" srcset="{{ asset | append: '.webp' | asset_url }}">
            <img src="{{ asset | append: '.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1600" height="1200" loading="lazy">
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="cfeat__body">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="cfeat__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="cfeat__lede">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaign feature",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "default_asset", "label": "Built-in image", "options": [
      { "value": "none", "label": "None" },
      { "value": "hero-a", "label": "Campaign A — Grooming (blue)" },
      { "value": "hero-b", "label": "Campaign B — Hair (green)" },
      { "value": "grooming", "label": "Grooming close-up" },
      { "value": "hair", "label": "Hair close-up" }
    ], "default": "hair" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Overrides the built-in image. Use a large lifestyle or campaign shot." },
    { "type": "select", "id": "media_position", "label": "Image position", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Designed for your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precision technology. Everyday performance." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tools that feel considered in the hand and hold up over years of daily use." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "select", "id": "color_scheme", "label": "t:settings.color_scheme.label", "options": [
      { "value": "", "label": "t:settings.color_scheme.light" },
      { "value": "color-surface", "label": "t:settings.color_scheme.surface" },
      { "value": "color-dark", "label": "t:settings.color_scheme.dark" }
    ], "default": "" }
  ],
  "presets": [ { "name": "Campaign feature" } ]
}
{% endschema %}

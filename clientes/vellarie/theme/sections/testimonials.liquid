{%- liquid
  assign cols = section.settings.columns
  assign pct = section.settings.rating | times: 20
  assign has_content = false
  if section.blocks.size > 0
    assign has_content = true
  endif
-%}
<section class="section{% unless has_content %} section--tight{% endunless %} {{ section.settings.color_scheme }}" data-testimonials>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head" data-reveal><h2 class="section-head__title">{{ section.settings.heading }}</h2></div>
    {%- endif -%}

    {%- if section.settings.show_summary and section.settings.rating > 0 -%}
      <div class="rating-summary" data-reveal>
        <span class="stars" style="--pct: {{ pct }}%" aria-hidden="true">★★★★★</span>
        <span class="rating-summary__n">
          {{ section.settings.rating }} / 5
          {%- if section.settings.review_count != blank %} &middot; {{ section.settings.review_count }} reviews{% endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- if has_content -%}
      <div class="testi-grid testi-grid--{{ cols }}" data-reveal-stagger>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'quote' -%}
              <blockquote class="testi" {{ block.shopify_attributes }}>
                {%- if block.settings.stars > 0 -%}
                  <span class="testi__stars" aria-hidden="true">
                    {%- for i in (1..5) -%}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{%- endfor -%}
                  </span>
                {%- endif -%}
                <p class="testi__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
                <footer class="testi__meta">
                  {{ block.settings.author }}{% if block.settings.detail != blank %} &middot; {{ block.settings.detail }}{% endif %}
                </footer>
              </blockquote>
            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="testi-note" data-reveal>{{ section.settings.empty_note }}</p>
    {%- endif -%}

    {%- if section.settings.note != blank and has_content -%}
      <p class="testi-note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "select", "id": "columns", "label": "Columns", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }
    ], "default": "3" },
    { "type": "header", "content": "Rating summary" },
    { "type": "paragraph", "content": "Leave OFF until you have a real average from a reviews app. Never enter numbers you cannot back up." },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": false },
    { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 0.1, "label": "Average rating", "default": 0 },
    { "type": "text", "id": "review_count", "label": "Review count" },
    { "type": "header", "content": "Reviews" },
    { "type": "paragraph", "content": "Add an app block below (Judge.me, Loox, Shopify Product Reviews) for verified reviews, or add Quote blocks with real customer words + permission." },
    { "type": "text", "id": "empty_note", "label": "Text shown while empty", "default": "Verified customer reviews are on the way — connect your reviews app to display them here." },
    { "type": "text", "id": "note", "label": "Footnote" },
    { "type": "select", "id": "color_scheme", "label": "t:settings.color_scheme.label", "options": [
      { "value": "", "label": "t:settings.color_scheme.light" },
      { "value": "color-surface", "label": "t:settings.color_scheme.surface" },
      { "value": "color-dark", "label": "t:settings.color_scheme.dark" }
    ], "default": "color-surface" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Use real words, with the customer's permission." },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" },
        { "type": "range", "id": "stars", "min": 0, "max": 5, "step": 1, "label": "Stars", "default": 5 }
      ]
    },
    { "type": "@app" }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Testimonials" }
  ]
}
{% endschema %}

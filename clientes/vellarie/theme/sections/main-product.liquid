{%- liquid
  assign product = product
  assign variant = product.selected_or_first_available_variant
  assign coll = product.collections.first
-%}
<section class="section" data-pdp
  data-handle="{{ product.handle }}"
  data-title="{{ product.title | escape }}"
  data-image="{{ product.featured_image | image_url: width: 400 }}"
  data-url="{{ product.url }}"
  data-price="{{ product.price | money | strip_html | escape }}">
  <div class="container">
    <nav class="pdp__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a> /
      {%- if coll -%}<a href="{{ coll.url }}">{{ coll.title }}</a> / {% endif -%}
      <span>{{ product.title }}</span>
    </nav>

    <div class="pdp">
      {% render 'product-media-gallery', product: product %}

      <div class="pdp__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <h1 class="pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- when 'price' -%}
              <div class="pdp__price" data-pdp-price {{ block.shopify_attributes }}>
                {%- if variant.compare_at_price > variant.price -%}
                  {%- assign pdp_saved = variant.compare_at_price | minus: variant.price -%}
                  {%- assign pdp_saved_pct = pdp_saved | times: 100.0 | divided_by: variant.compare_at_price | round -%}
                  <span class="price--sale">{{ variant.price | money }}</span>
                  <span class="price--compare">{{ variant.compare_at_price | money }}</span>
                  <span class="price--save">Save {{ pdp_saved | money }} ({{ pdp_saved_pct }}%)</span>
                {%- else -%}
                  <span>{{ variant.price | money }}</span>
                {%- endif -%}
              </div>
            {%- when 'rating' -%}
              {% render 'rating', product: product %}
            {%- when 'description_short' -%}
              {%- if product.metafields.custom.subtitle != blank -%}
                <p class="pdp__desc" {{ block.shopify_attributes }}>{{ product.metafields.custom.subtitle }}</p>
              {%- elsif block.settings.fallback_excerpt -%}
                <p class="pdp__desc" {{ block.shopify_attributes }}>{{ product.description | strip_html | truncatewords: 40 }}</p>
              {%- endif -%}
            {%- when 'variant_picker' -%}
              {% render 'variant-picker', product: product, block: block %}
            {%- when 'buy_buttons' -%}
              {% render 'buy-buttons', product: product, block: block %}
            {%- when 'trust' -%}
              <div class="pdp__trust" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}<span>{% render 'icon', name: 'shipping' %}{{ block.settings.item_1 }}</span>{%- endif -%}
                {%- if block.settings.item_2 != blank -%}<span>{% render 'icon', name: 'return' %}{{ block.settings.item_2 }}</span>{%- endif -%}
                {%- if block.settings.item_3 != blank -%}<span>{% render 'icon', name: 'lock' %}{{ block.settings.item_3 }}</span>{%- endif -%}
              </div>
            {%- when 'payments' -%}
              <div class="pdp__payments" {{ block.shopify_attributes }}>
                <span>{{ block.settings.label }}</span>
                {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
              </div>
            {%- when 'accordion' -%}
              <div class="accordion" data-accordion {{ block.shopify_attributes }}>
                <div class="accordion__item">
                  <button class="accordion__trigger" aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}">
                    <span>{{ block.settings.heading }}</span>{% render 'icon', name: 'plus', class: 'accordion__icon' %}
                  </button>
                  <div class="accordion__panel"{% if block.settings.open %} style="max-height:1000px"{% endif %}>
                    <div class="accordion__panel-inner rte">
                      {%- if block.settings.content != blank -%}{{ block.settings.content }}{%- endif -%}
                      {%- if block.settings.use_product_description -%}{{ product.description }}{%- endif -%}
                      {%- if block.settings.metafield != blank -%}{{ product.metafields.custom[block.settings.metafield].value }}{%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Mobile sticky add-to-cart {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc>
  <span class="sticky-atc__price" data-sticky-price>{{ variant.price | money }}</span>
  <button class="btn" data-sticky-atc-btn><span class="btn__label">{{ 'products.product.add_to_cart' | t }}</span></button>
</div>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "blocks": [
    { "type": "title", "name": "t:sections.main_product.title", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.price", "limit": 1 },
    { "type": "rating", "name": "t:sections.main_product.rating", "limit": 1 },
    { "type": "description_short", "name": "t:sections.main_product.description_short", "limit": 1, "settings": [
      { "type": "checkbox", "id": "fallback_excerpt", "label": "t:sections.main_product.fallback_excerpt", "default": true }
    ] },
    { "type": "variant_picker", "name": "t:sections.main_product.variant_picker", "limit": 1 },
    { "type": "buy_buttons", "name": "t:sections.main_product.buy_buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.main_product.show_dynamic_checkout", "default": true }
    ] },
    { "type": "trust", "name": "t:sections.main_product.trust", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Only enter benefits your store actually offers." },
      { "type": "text", "id": "item_1", "label": "1", "default": "Free US shipping over $75" },
      { "type": "text", "id": "item_2", "label": "2", "default": "30-day returns" },
      { "type": "text", "id": "item_3", "label": "3", "default": "Secure checkout" }
    ] },
    { "type": "payments", "name": "t:sections.main_product.payments", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "t:sections.main_product.payments_label", "default": "Secure checkout with" }
    ] },
    { "type": "accordion", "name": "t:sections.main_product.accordion", "settings": [
      { "type": "text", "id": "heading", "label": "t:sections.main_product.accordion_heading", "default": "Details" },
      { "type": "richtext", "id": "content", "label": "t:sections.main_product.accordion_content" },
      { "type": "checkbox", "id": "use_product_description", "label": "t:sections.main_product.use_product_description", "default": false },
      { "type": "text", "id": "metafield", "label": "t:sections.main_product.accordion_metafield", "info": "t:sections.main_product.accordion_metafield_info" },
      { "type": "checkbox", "id": "open", "label": "t:sections.main_product.accordion_open", "default": false }
    ] }
  ],
  "settings": [],
  "presets": [
    {
      "name": "t:sections.main_product.name",
      "blocks": [
        { "type": "title" },
        { "type": "price" },
        { "type": "rating" },
        { "type": "description_short" },
        { "type": "variant_picker" },
        { "type": "buy_buttons" },
        { "type": "trust" },
        { "type": "payments" },
        { "type": "accordion", "settings": { "heading": "Details", "use_product_description": true, "open": true } },
        { "type": "accordion", "settings": { "heading": "Shipping" } },
        { "type": "accordion", "settings": { "heading": "Returns & exchanges" } }
      ]
    }
  ]
}
{% endschema %}

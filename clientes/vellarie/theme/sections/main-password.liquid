<section class="page-404 color-dark" style="min-height:100svh" data-section-id="{{ section.id }}">
  <div class="container" style="display:grid;gap:1.5rem;max-width:520px">
    <p class="display" style="font-size:clamp(2.5rem,9vw,5rem)">{{ shop.name }}</p>
    {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
    <p class="eyebrow">{{ 'templates.password.opening_soon' | t }}</p>

    {%- form 'storefront_password', class: 'newsletter__form' -%}
      <input type="password" name="password" placeholder="{{ 'templates.password.password_placeholder' | t }}" aria-label="{{ 'templates.password.password_label' | t }}" required>
      <button type="submit">{{ 'templates.password.enter' | t }}</button>
      {%- if form.errors -%}<p class="form-note form-note--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}

    {%- if section.settings.show_newsletter -%}
      <div style="margin-top:1.5rem">
        <p class="eyebrow" style="margin-bottom:.75rem">{{ 'templates.password.signup' | t }}</p>
        {% render 'newsletter-form' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    { "type": "richtext", "id": "text", "label": "t:sections.rich_text.text", "default": "<p>Something is coming.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:sections.main_password.show_newsletter", "default": true }
  ]
}
{% endschema %}

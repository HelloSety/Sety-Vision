<section class="trust-bar" data-reveal>
  <div class="container">
    <div class="trust-bar__grid">
      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <div>
            <p class="trust-item__t">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}<p class="trust-item__d">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.trust_bar.name",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust_bar.item",
      "settings": [
        { "type": "select", "id": "icon", "label": "t:sections.trust_bar.icon", "options": [
          { "value": "shipping", "label": "Shipping" },
          { "value": "shield", "label": "Shield" },
          { "value": "return", "label": "Return" },
          { "value": "card", "label": "Card" },
          { "value": "lock", "label": "Lock" },
          { "value": "star", "label": "Star" }
        ], "default": "shipping" },
        { "type": "text", "id": "title", "label": "t:sections.trust_bar.title", "default": "Free US shipping" },
        { "type": "text", "id": "text", "label": "t:sections.trust_bar.text", "info": "Only enter benefits your store actually offers.", "default": "On orders over $75" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_bar.name",
      "blocks": [
        { "type": "item", "settings": { "icon": "shipping", "title": "Free US shipping", "text": "On orders over $75" } },
        { "type": "item", "settings": { "icon": "return", "title": "30-day returns", "text": "Easy and no-hassle" } },
        { "type": "item", "settings": { "icon": "shield", "title": "1-year warranty", "text": "On every device" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Encrypted and protected" } }
      ]
    }
  ]
}
{% endschema %}

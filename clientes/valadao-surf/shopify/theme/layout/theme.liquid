<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {{ page_title }}{% if page_title contains 'Valadão Street Wear' %}{% else %} — Valadão Street Wear{% endif %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="Valadão Street Wear: streetwear e moda urbana original — moletons, jaquetas, bermudas, bonés, chinelos e infantil. Compre direto pelo WhatsApp.">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {% else %}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_img_url: '32x' }}">
  {% endif %}

  <meta property="og:site_name" content="Valadão Street Wear">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Anton&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body>

  <div class="anuncio-bar"><span><strong>{{ settings.topbar_highlight | default: 'FRETE GRÁTIS' }}</strong> {{ settings.topbar_text | default: 'acima de R$299 — Parcele em até 12x' }}</span></div>

  {% section 'header' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  <div class="newsletter">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 5h18v14H3z"/><path d="M3 5l9 7 9-7"/></svg>
    <p>Receba nossas novidades por e-mail</p>
    <strong>Fique por dentro dos lançamentos</strong>
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="newsletter-success">Cadastro recebido! Em breve você recebe nossas novidades.</p>
      {%- else -%}
        <input type="text" name="contact[first_name]" placeholder="Nome completo" required>
        <input type="email" name="contact[email]" placeholder="E-mail" required>
        <button type="submit">Cadastrar</button>
      {%- endif -%}
    {%- endform -%}
  </div>

  {% section 'footer' %}

  {%- if settings.whatsapp_number != blank -%}
  <a class="whats-float" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg viewBox="0 0 32 32"><path fill="#fff" d="M23.5 8.5a10 10 0 0 0-15.9 12L6 26l5.7-1.5a10 10 0 0 0 4.3 1 10 10 0 0 0 7.5-16.9zm-7.5 15.4a8.3 8.3 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3a8.3 8.3 0 1 1 15.4-4.4 8.3 8.3 0 0 1-8.4 8.2zm4.5-6.2c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1s-.7.8-.9 1c-.2.2-.3.2-.6.1a6.8 6.8 0 0 1-2-1.2 7.5 7.5 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.2.2-.4a.4.4 0 0 0 0-.4c-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c.6.3 1.1.4 1.5.6.6.2 1.2.1 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.2-.2-.4-.3z"/></svg>
  </a>
  {%- endif -%}

  <div id="cart-drawer"></div>
  <div class="add-toast" id="add-toast">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
    <span>Adicionado ao carrinho!</span>
  </div>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>

<section class="section container" style="padding-top:0">
  <div class="about-grid">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_tag: width: 300, alt: section.settings.heading, loading: 'lazy', class: 'about-logo-img' }}
    {%- else -%}
      <img class="about-logo-img" src="{{ 'about-model.jpg' | asset_img_url: '300x' }}" alt="{{ section.settings.heading }}" width="300" height="300" loading="lazy">
    {%- endif -%}
    <div>
      <h2>{{ section.settings.heading | default: 'O que é a Valadão Street Wear' }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sobre a Loja",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "heading", "label": "Título", "default": "O que é a Valadão Street Wear" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "A Valadão Street Wear nasceu da cultura de rua: moletons, jaquetas, bermudas, bonés e chinelos de marca para quem vive o streetwear de verdade. Curadoria própria com peças de marcas como MCD, Lost, Quiksilver e Chronic — qualidade que se sente e estilo que representa." }
  ],
  "presets": [{ "name": "Sobre a Loja" }]
}
{% endschema %}

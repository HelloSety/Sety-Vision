<section class="section container">
  <div class="section-head"><h2>{{ collection.title | default: 'Todos os Produtos' }}</h2></div>

  <div class="filters">
    <a class="filter-btn {% if collection.handle == 'all' or collection.handle == blank %}active{% endif %}" href="{{ routes.all_products_collection_url }}">Todos</a>
    {%- for link in linklists[settings.main_menu].links -%}
      {%- if link.type == 'collection_link' -%}
        <a class="filter-btn {% if link.object.handle == collection.handle %}active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <p style="color:var(--cinza); font-size:13px; margin-bottom:18px">{{ collection.products_count | default: collection.all_products_count }} produtos encontrados</p>

  {%- paginate collection.products by 48 -%}
    <div class="grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>Nenhum produto encontrado nesta categoria.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="center-cta" style="display:flex;gap:10px;justify-content:center">
        {%- if paginate.previous -%}<a class="btn-dark" href="{{ paginate.previous.url }}">← Anterior</a>{%- endif -%}
        {%- if paginate.next -%}<a class="btn-dark" href="{{ paginate.next.url }}">Próxima →</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        {%- if settings.logo -%}
          {{ settings.logo | image_tag: width: 400, alt: shop.name }}
        {%- else -%}
          <span class="logo-wordmark">VALADÃO<span> STREET WEAR</span></span>
        {%- endif -%}
        <p>{{ section.settings.footer_text | default: 'Streetwear e moda urbana original: moletons, jaquetas, bermudas, bonés e chinelos de marca.' }}</p>
        {%- if settings.instagram_url != blank -%}
        <a class="footer-social" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          Siga no Instagram
        </a>
        {%- endif -%}
      </div>
      <div>
        <h4>Navegação</h4>
        <ul>
          {%- for link in linklists[section.settings.footer_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
      <div>
        <h4>Central de Atendimento</h4>
        <ul>
          <li>{{ section.settings.support_hours | default: 'Atendimento: seg. a sáb. 9h às 18h' }}</li>
          <li>Contato: {{ section.settings.support_phone | default: 'via WhatsApp' }}</li>
        </ul>
        {%- if settings.whatsapp_number != blank -%}
        <a class="footer-whats" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#fff" fill-opacity=".15"/><path fill="#fff" d="M23.5 8.5a10 10 0 0 0-15.9 12L6 26l5.7-1.5a10 10 0 0 0 4.3 1 10 10 0 0 0 7.5-16.9zm-7.5 15.4a8.3 8.3 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3a8.3 8.3 0 1 1 15.4-4.4 8.3 8.3 0 0 1-8.4 8.2zm4.5-6.2c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1s-.7.8-.9 1c-.2.2-.3.2-.6.1a6.8 6.8 0 0 1-2-1.2 7.5 7.5 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.2.2-.4a.4.4 0 0 0 0-.4c-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c.6.3 1.1.4 1.5.6.6.2 1.2.1 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.2-.2-.4-.3z"/></svg>
          Atendimento via WhatsApp
        </a>
        {%- endif -%}
      </div>
      <div>
        <h4>Formas de Pagamento</h4>
        <div class="payment-icons">
          <span class="pay-icon"><img src="{{ 'visa.svg' | asset_url }}" alt="Visa" width="34" height="20" loading="lazy"></span>
          <span class="pay-icon"><img src="{{ 'mastercard.svg' | asset_url }}" alt="Mastercard" width="34" height="20" loading="lazy"></span>
          <span class="pay-icon"><img src="{{ 'elo.svg' | asset_url }}" alt="Elo" width="34" height="20" loading="lazy"></span>
          <span class="pay-icon"><img src="{{ 'pix.svg' | asset_url }}" alt="Pix" width="34" height="20" loading="lazy"></span>
          <span class="pay-icon pay-icon-boleto">Boleto</span>
        </div>
        <h4 style="margin-top:26px">Loja Verificada</h4>
        <div class="trust-badges">
          <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg> Peças Originais</span>
          <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg> Compra Segura</span>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} Valadão Street Wear. Todos os direitos reservados.</span>
      <a class="sety-seal" href="https://setystudio.com.br" target="_blank" rel="noopener">
        Feito por <img src="{{ 'sety-studio-mark.svg' | asset_url }}" alt="" width="16" height="16"> Sety Studio
      </a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    { "type": "link_list", "id": "footer_menu", "label": "Menu do rodapé", "default": "footer" },
    { "type": "textarea", "id": "footer_text", "label": "Texto institucional curto" },
    { "type": "text", "id": "support_hours", "label": "Horário de atendimento" },
    { "type": "text", "id": "support_phone", "label": "Telefone de atendimento" }
  ]
}
{% endschema %}

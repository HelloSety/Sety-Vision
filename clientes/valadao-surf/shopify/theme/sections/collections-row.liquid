<section class="section container" style="padding-top:0">
  <div class="section-head-center"><h2>{{ section.settings.heading | default: 'Encontre sua Categoria' }}</h2></div>
  <p class="section-sub">Coleções</p>
  <div class="collections-row">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <a class="collection-item" href="{{ col.url | default: '#' }}">
        <div class="collection-circle">
          {%- case col.handle -%}
            {%- when 'camisas-futebol' -%}
              <img src="{{ 'cat-futebol.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'nba' -%}
              <img src="{{ 'cat-nba.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'streetwear' -%}
              <img src="{{ 'cat-streetwear.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'perfumes' -%}
              <img src="{{ 'cat-perfumes.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'oculos' -%}
              <img src="{{ 'cat-oculos.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'calcados' -%}
              <img src="{{ 'cat-calcados.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'mochilas' -%}
              <img src="{{ 'cat-mochilas.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'bones' -%}
              <img src="{{ 'cat-bones.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'academia' -%}
              <img src="{{ 'cat-academia.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'eletronicos' -%}
              <img src="{{ 'cat-eletronicos.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'bolas' -%}
              <img src="{{ 'cat-bolas.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'infantil' -%}
              <img src="{{ 'cat-infantil.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- when 'acessorios' -%}
              <img src="{{ 'cat-acessorios.jpg' | asset_img_url: '400x' }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
            {%- else -%}
              <img src="{{ 'default-hero.jpg' | asset_url }}" alt="{{ block.settings.label | default: col.title }}" width="400" height="400" loading="lazy">
          {%- endcase -%}
          <span>{{ block.settings.label | default: col.title }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrossel de Coleções",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Encontre sua Categoria" }
  ],
  "blocks": [
    {
      "type": "collection_circle",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "text", "id": "label", "label": "Nome exibido (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrossel de Coleções",
      "blocks": [
        { "type": "collection_circle" }, { "type": "collection_circle" }, { "type": "collection_circle" },
        { "type": "collection_circle" }, { "type": "collection_circle" }, { "type": "collection_circle" }
      ]
    }
  ]
}
{% endschema %}

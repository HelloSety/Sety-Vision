<header class="site-header">
  <div class="header-top">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" name="q" placeholder="O que você está buscando?" value="{{ search.terms | escape }}">
    </form>

    <a href="{{ routes.root_url }}" class="logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_tag: width: 400, alt: shop.name }}
      {%- else -%}
        <span class="logo-wordmark">VALADÃO<span> STREET WEAR</span></span>
      {%- endif -%}
    </a>

    <div class="header-icons">
      {%- if settings.instagram_url != blank -%}
      <a class="icon-link" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
      </a>
      {%- endif -%}
      {%- if settings.whatsapp_number != blank -%}
      <a class="icon-link" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.5-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.3-.5.1-.2 0-.4 0-.5C10.1 9 9.5 7.6 9.3 7c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 2-1.4.2-.7.2-1.2.1-1.4-.1-.1-.3-.2-.6-.3z"/><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2z"/></svg>
      </a>
      {%- endif -%}
      <a class="cart-icon-btn cart-trigger" href="{{ routes.cart_url }}" aria-label="Carrinho">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8h12l1 12H5z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="cart-badge{% if cart.item_count == 0 %} hide{% endif %}" id="cart-badge-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav class="main-nav">
    {%- for link in linklists[settings.main_menu].links -%}
      <a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  </nav>
</header>

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu de navegação",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
